{{/*
shell-tools-init - bash/zsh 共享的工具初始化逻辑
被 dot_zshrc.tmpl 和 dot_bash_aliases.tmpl 引用，避免重复

包含：
- starship / zoxide / fzf init 缓存（按 binary mtime 失效）
- EDITOR 智能选择
- Python/pip alias
- PATH 注入
*/}}

# 检测当前 shell（值加引号：裸 sh/bash 会被 shellcheck 误判为命令替换 SC2209）
if [ -n "${ZSH_VERSION:-}" ]; then
    __DOTFILES_SHELL="zsh"
elif [ -n "${BASH_VERSION:-}" ]; then
    __DOTFILES_SHELL="bash"
else
    __DOTFILES_SHELL="sh"
fi

# =========================
# 工具 init 缓存（按 binary mtime 失效，shell 启动加速 50-100ms）
# =========================
__dotfiles_init_cache() {
    local tool="$1" cache="$2"
    local bin
    bin=$(command -v "$tool" 2>/dev/null) || return 0
    if [ ! -f "$cache" ] || [ "$bin" -nt "$cache" ]; then
        mkdir -p "$(dirname "$cache")"
        case "$tool" in
            starship)  "$bin" init "$__DOTFILES_SHELL" > "$cache" 2>/dev/null || true ;;
            zoxide)    "$bin" init "$__DOTFILES_SHELL" > "$cache" 2>/dev/null || true ;;
            fzf)       "$bin" "--$__DOTFILES_SHELL" > "$cache" 2>/dev/null || true ;;
        esac
    fi
    # 容错：缓存空或损坏时不中断 shell 启动
    [ -s "$cache" ] && { . "$cache" 2>/dev/null || true; }
}

# =========================
# fzf 默认行为(配色 / 后端 / 预览)
# 必须在 fzf init 之前设置：key-bindings 运行时读取这些变量
# =========================
if command -v fzf > /dev/null 2>&1; then
    # Catppuccin Mocha 配色，与 Ghostty / tmux / bat 主题统一
    export FZF_DEFAULT_OPTS="
      --height 60% --layout=reverse --border=rounded --info=inline
      --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
      --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
      --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"

    # 后端优先用 fd：尊重 .gitignore、跳过 .git，比默认的 find 快一个量级
    # (Ubuntu/Debian 上命令名是 fdfind)
    __dotfiles_fd=""
    if command -v fd > /dev/null 2>&1; then
        __dotfiles_fd="fd"
    elif command -v fdfind > /dev/null 2>&1; then
        __dotfiles_fd="fdfind"
    fi
    if [ -n "$__dotfiles_fd" ]; then
        export FZF_DEFAULT_COMMAND="$__dotfiles_fd --type f --hidden --follow --exclude .git"
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND="$__dotfiles_fd --type d --hidden --follow --exclude .git"
    fi

    # Ctrl+T 文件预览（bat 高亮，无 bat 时退回 head）
    __dotfiles_bat=""
    if command -v bat > /dev/null 2>&1; then
        __dotfiles_bat="bat"
    elif command -v batcat > /dev/null 2>&1; then
        __dotfiles_bat="batcat"
    fi
    if [ -n "$__dotfiles_bat" ]; then
        export FZF_CTRL_T_OPTS="--preview '$__dotfiles_bat --color=always --style=numbers --line-range=:200 {}' --preview-window=right:60%:wrap"
    else
        export FZF_CTRL_T_OPTS="--preview 'head -200 {}' --preview-window=right:60%:wrap"
    fi

    # Alt+C 目录预览（lsd 树状，无 lsd 时退回 ls）
    if command -v lsd > /dev/null 2>&1; then
        export FZF_ALT_C_OPTS="--preview 'lsd --tree --depth 2 --color=always {}' --preview-window=right:50%"
    else
        export FZF_ALT_C_OPTS="--preview 'ls -1 {}' --preview-window=right:50%"
    fi

    # Ctrl+R 历史：长命令在下方完整展开，避免被截断看不全
    export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window=down:3:hidden:wrap --bind '?:toggle-preview'"

    unset __dotfiles_fd __dotfiles_bat
fi

__dotfiles_init_cache starship "${HOME}/.cache/starship/init.${__DOTFILES_SHELL}"
__dotfiles_init_cache zoxide   "${HOME}/.cache/zoxide/init.${__DOTFILES_SHELL}"
__dotfiles_init_cache fzf      "${HOME}/.cache/fzf/init.${__DOTFILES_SHELL}"

# =========================
# EDITOR 智能选择 (nvim > vim > vi)
# =========================
if command -v nvim >/dev/null 2>&1; then
    export EDITOR=nvim
    export VISUAL=nvim
elif command -v vim >/dev/null 2>&1; then
    export EDITOR=vim
    export VISUAL=vim
else
    export EDITOR=vi
    export VISUAL=vi
fi

# =========================
# Python / pip 便捷别名
# =========================
if command -v python3 >/dev/null 2>&1; then
    alias python=python3
fi
if command -v pip3 >/dev/null 2>&1; then
    alias pip=pip3
fi

# =========================
# PATH 注入（用户级 bin 目录）
# =========================
case ":${PATH}:" in
    *":${HOME}/bin:"*) ;;
    *) export PATH="${HOME}/bin:${PATH}" ;;
esac
case ":${PATH}:" in
    *":${HOME}/.local/bin:"*) ;;
    *) export PATH="${HOME}/.local/bin:${PATH}" ;;
esac
