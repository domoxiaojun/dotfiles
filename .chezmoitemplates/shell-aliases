# =========================
# 终端美化工具别名（24-bit 真彩色）
# 此文件由 zshrc 和 bash_aliases 共享
# =========================

# lsd - 彩色 ls（带图标和文件类型）
if command -v lsd &> /dev/null; then
  alias ls='lsd'
  alias ll='lsd -l'
  alias la='lsd -la'
  alias lt='lsd --tree'
fi

# fd - 更好的 find
{{ if eq .chezmoi.os "linux" -}}
# Ubuntu/Debian 上 fd 命令名为 fdfind
if command -v fdfind &> /dev/null && ! command -v fd &> /dev/null; then
  alias fd='fdfind'
fi
{{ end -}}

# bat - 彩色 cat（语法高亮）
{{ if eq .chezmoi.os "linux" -}}
# Ubuntu/Debian 上 bat 命令名为 batcat
if command -v batcat &> /dev/null; then
  alias cat='batcat --style=plain --paging=never'
  alias catt='batcat --paging=never'
  alias batp='batcat'
elif command -v bat &> /dev/null; then
  alias cat='bat --style=plain --paging=never'
  alias catt='bat --paging=never'
  alias batp='bat'
fi
{{ else -}}
if command -v bat &> /dev/null; then
  alias cat='bat --style=plain --paging=never'
  alias catt='bat --paging=never'
  alias batp='bat'
fi
{{ end -}}

# glow - Markdown 渲染
if command -v glow &> /dev/null; then
  alias md='glow'
fi

# btop - 系统监控
if command -v btop &> /dev/null; then
  alias top='btop'
fi
