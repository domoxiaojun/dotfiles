{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# 此脚本在 chezmoi apply 时自动运行
# 用于安装必要的工具和依赖
# version: 3.0.0  - 工具清单数据化 + zoxide + SHA 校验提示

set -e

echo "🚀 开始安装依赖工具..."

# ============================================================
# 安装 Homebrew
# ============================================================
# 安全提示：Homebrew 官方安装脚本，未做 SHA 校验；
# 如需校验，先手动下载 install.sh 审查内容/核对摘要后再执行：
#   curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh | shasum -a 256
if ! command -v brew &> /dev/null; then
    echo "📦 安装 Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
else
    echo "✅ Homebrew 已安装"
fi

# 检查并安装 Git
echo "📦 检查 Git..."
if ! command -v git &> /dev/null; then
    echo "🔧 安装 Git..."
    brew install git
else
    echo "✅ Git 已安装"
fi

# ============================================================
# 从工具清单读取（chezmoi 模板渲染时注入）
# ============================================================
# 每行一个: <name> <brew_formula>，brew 为 "-" 时跳过
read -r -d '' BREW_TOOLS <<'EOF' || true
{{- range .toolList -}}
{{-   if .brew }}
{{ .name }} {{ .brew }}
{{-   end }}
{{- end }}
EOF

# ============================================================
# 一次性获取已安装 formula 列表，避免每个工具重复 grep
# ============================================================
echo ""
echo "📦 检查已安装的 brew 包..."
INSTALLED_FORMULAS=$(brew list --formula -1 2>/dev/null | sort -u)

# ============================================================
# 批量安装核心工具
# ============================================================
echo ""
echo "📦 安装终端和 Shell 工具..."

while IFS=' ' read -r tool_name formula; do
    [ -z "$formula" ] && continue
    if printf '%s\n' "$INSTALLED_FORMULAS" | grep -qxF "$formula"; then
        echo "   ✅ $formula 已安装"
    else
        echo "   安装 $formula ..."
        brew install "$formula" || echo "   ⚠️  $formula 安装失败"
    fi
done <<< "$BREW_TOOLS"

# ============================================================
# Cask 安装：ghostty + Nerd Font
# ============================================================
INSTALLED_CASKS=$(brew list --cask -1 2>/dev/null | sort -u)

install_cask() {
    local cask="$1"
    if printf '%s\n' "$INSTALLED_CASKS" | grep -qxF "$cask"; then
        echo "   ✅ $cask (cask) 已安装"
    else
        echo "   安装 $cask (cask) ..."
        brew install --cask "$cask" || echo "   ⚠️  $cask 安装失败"
    fi
}

echo ""
echo "📦 安装 GUI 应用 / 字体..."
install_cask ghostty
install_cask font-meslo-lg-nerd-font

# ============================================================
# 安装 TPM（Tmux 插件管理器）
# ============================================================
if [ ! -d ~/.tmux/plugins/tpm ]; then
    echo "📦 安装 TPM (Tmux Plugin Manager)..."
    git clone --depth 1 https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
else
    echo "✅ TPM 已安装"
fi

echo ""
echo "✅ 所有依赖安装完成！"
echo ""
echo "📝 后续步骤："
echo "  1. 重启终端"
echo "  2. 启动 tmux 并按 Ctrl+s Shift+i 安装插件"
echo "     Ctrl+s 已保留为 tmux 主前缀；交互式终端会自动关闭软件流控"
echo "  3. 享受你的新终端环境！"
{{ end -}}
