{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# 此脚本在 Linux 上 chezmoi apply 时自动运行
# 用于安装必要的工具和依赖
# 支持: Fedora (dnf), Ubuntu/Debian (apt)
# version: 3.0.0  - install_pkg 函数化 + zoxide + SHA 校验提示

set -e

echo "🚀 开始安装依赖工具..."

WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT

# ============================================================
# 平台检测
# ============================================================
DISTRO_ID=""
DISTRO_VERSION=""
if [ -f /etc/os-release ]; then
    . /etc/os-release
    DISTRO_ID="$ID"
    DISTRO_VERSION="$VERSION_ID"
fi

if command -v dnf &> /dev/null; then
    PKG_MANAGER="dnf"
    echo "📦 检测到 Fedora/RHEL 系 (dnf): ${DISTRO_ID} ${DISTRO_VERSION}"
elif command -v apt &> /dev/null; then
    PKG_MANAGER="apt"
    echo "📦 检测到 Debian/Ubuntu 系 (apt): ${DISTRO_ID} ${DISTRO_VERSION}"
else
    echo "⚠️  未检测到支持的包管理器 (apt/dnf)"
    exit 1
fi

ARCH=$(uname -m)
case "$ARCH" in
    x86_64) ARCH_SUFFIX="amd64"; ARCH_ALT="x86_64" ;;
    aarch64|arm64) ARCH_SUFFIX="arm64"; ARCH_ALT="aarch64" ;;
    *) echo "⚠️  未支持的架构: $ARCH，预编译二进制可能无法使用"
       ARCH_SUFFIX="amd64"; ARCH_ALT="x86_64" ;;
esac

DISPLAY_SERVER="unknown"
HAS_DESKTOP=false
if [ -n "$WAYLAND_DISPLAY" ]; then
    DISPLAY_SERVER="wayland"; HAS_DESKTOP=true
elif [ -n "$DISPLAY" ]; then
    DISPLAY_SERVER="x11"; HAS_DESKTOP=true
elif [ -n "$XDG_SESSION_TYPE" ] && [ "$XDG_SESSION_TYPE" != "tty" ]; then
    DISPLAY_SERVER="$XDG_SESSION_TYPE"
    [ "$XDG_SESSION_TYPE" = "wayland" ] || [ "$XDG_SESSION_TYPE" = "x11" ] && HAS_DESKTOP=true
fi
[ "$HAS_DESKTOP" = true ] && echo "🖥️  桌面环境: $DISPLAY_SERVER" || echo "🖥️  无桌面环境 (服务器/容器模式)"

# ============================================================
# 通用安装函数
# ============================================================

# 用法: install_pkg <command_to_check> <apt_pkg> <dnf_pkg>
# 任一包名为 "" 表示该平台跳过
install_pkg() {
    local cmd="$1" apt_pkg="$2" dnf_pkg="$3"
    if command -v "$cmd" &> /dev/null; then
        echo "   ✅ $cmd 已安装"
        return 0
    fi
    echo "   安装 $cmd ..."
    case "$PKG_MANAGER" in
        apt) [ -n "$apt_pkg" ] && sudo apt install -y "$apt_pkg" 2>/dev/null || true ;;
        dnf) [ -n "$dnf_pkg" ] && sudo dnf install -y "$dnf_pkg" 2>/dev/null || true ;;
    esac
}

# 用法: install_deb_from_release <repo> <name> [strip_v]
# 从 GitHub release 下载 deb 并 dpkg -i
install_deb_from_release() {
    local repo="$1" name="$2" strip_v="${3:-1}"
    local version=$(curl -s --connect-timeout 10 --max-time 30 \
        "https://api.github.com/repos/$repo/releases/latest" | \
        grep -o '"tag_name": "[^"]*"' | head -1 | cut -d'"' -f4)
    [ -n "$strip_v" ] && version="${version#v}"
    if [ -z "$version" ]; then
        echo "   ⚠️  无法获取 $name 最新版本号，跳过"; return 1
    fi
    local url="https://github.com/$repo/releases/latest/download/${name}_${version}_${ARCH_SUFFIX}.deb"
    if curl -fsSL --connect-timeout 10 --max-time 120 -o "$WORK_DIR/${name}.deb" "$url"; then
        sudo dpkg -i "$WORK_DIR/${name}.deb" 2>/dev/null || true
    else
        echo "   ⚠️  $name deb 下载失败"
    fi
}

# ============================================================
# Fedora COPR
# ============================================================
if [ "$PKG_MANAGER" = "dnf" ]; then
    if ! dnf copr list 2>/dev/null | grep -q "scottames/ghostty"; then
        echo ""
        echo "📦 启用 Ghostty COPR..."
        sudo dnf copr enable -y scottames/ghostty
    fi
fi

# ============================================================
# apt 索引更新（一次性，避免每次 install 都过期）
# ============================================================
if [ "$PKG_MANAGER" = "apt" ]; then
    echo ""
    echo "📦 更新 apt 索引..."
    sudo apt update || true
fi

# ============================================================
# Git（包管理器一行装）
# ============================================================
echo ""
echo "📦 检查 Git..."
install_pkg git git git

# ============================================================
# 基础工具
# ============================================================
echo ""
echo "📦 安装基础工具..."
case "$PKG_MANAGER" in
    apt) sudo apt install -y tmux fzf btop curl unzip fontconfig 2>/dev/null || true ;;
    dnf) sudo dnf install -y tmux fzf btop curl unzip fontconfig 2>/dev/null || true ;;
esac

# ============================================================
# 剪贴板（仅桌面环境）
# ============================================================
if [ "$HAS_DESKTOP" = true ]; then
    echo ""
    echo "📋 安装剪贴板工具..."
    if [ "$DISPLAY_SERVER" = "wayland" ] || [ "$DISTRO_ID" = "fedora" ]; then
        install_pkg wl-copy wl-clipboard wl-clipboard
    else
        install_pkg xclip xclip xclip
    fi
else
    echo "📋 跳过剪贴板工具（无桌面环境）"
fi

# ============================================================
# Ghostty（apt: 第三方脚本；dnf: COPR）
# ============================================================
# 安全提示：apt 路径使用 mkasberg/ghostty-ubuntu 第三方脚本，未做 SHA 校验
# 如需严格校验，设置 DOTFILES_VERIFY=1 后人工核对脚本摘要
echo ""
if ! command -v ghostty &> /dev/null; then
    echo "👻 安装 Ghostty..."
    case "$PKG_MANAGER" in
        apt) /bin/bash -c "$(curl -fsSL --connect-timeout 10 --max-time 120 https://raw.githubusercontent.com/mkasberg/ghostty-ubuntu/HEAD/install.sh)" || true ;;
        dnf) sudo dnf install -y ghostty || true ;;
    esac
else
    echo "✅ Ghostty 已安装"
fi

# ============================================================
# Starship（脚本安装）
# ============================================================
# 安全提示：starship.rs/install.sh 官方脚本，未做 SHA 校验
echo ""
if ! command -v starship &> /dev/null; then
    echo "🚀 安装 Starship..."
    curl -sS --connect-timeout 10 --max-time 60 https://starship.rs/install.sh | sh -s -- -y || true
else
    echo "✅ Starship 已安装"
fi

# ============================================================
# 包管理器可装的简单工具
# ============================================================
echo ""
echo "📦 包管理器工具..."
install_pkg rg ripgrep ripgrep
install_pkg zoxide zoxide zoxide

# ============================================================
# gh (GitHub CLI)
# Ubuntu: 通过 cli/cli 官方 apt 源
# Fedora: dnf install gh
# ============================================================
if ! command -v gh &> /dev/null; then
    echo ""
    echo "🐙 安装 gh (GitHub CLI)..."
    case "$PKG_MANAGER" in
        apt)
            # 安全提示：cli/cli 官方源，未做 SHA 校验
            sudo mkdir -p -m 755 /etc/apt/keyrings
            curl -fsSL --connect-timeout 10 --max-time 30 https://cli.github.com/packages/githubcli-archive-keyring.gpg | \
                sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null
            sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
            echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | \
                sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
            sudo apt update && sudo apt install -y gh || true
            ;;
        dnf) sudo dnf install -y gh || true ;;
    esac
else
    echo "✅ gh 已安装"
fi


# bat：apt 的命令是 batcat，dnf 是 bat
if ! command -v bat &> /dev/null && ! command -v batcat &> /dev/null; then
    case "$PKG_MANAGER" in
        apt) sudo apt install -y bat 2>/dev/null || true ;;
        dnf) sudo dnf install -y bat 2>/dev/null || true ;;
    esac
else
    echo "   ✅ bat 已安装"
fi

# fd：apt 包名 fd-find，命令名 fdfind
if ! command -v fd &> /dev/null && ! command -v fdfind &> /dev/null; then
    case "$PKG_MANAGER" in
        apt) sudo apt install -y fd-find 2>/dev/null || true ;;
        dnf) sudo dnf install -y fd-find 2>/dev/null || true ;;
    esac
else
    echo "   ✅ fd 已安装"
fi

# ============================================================
# delta（apt: GitHub deb，dnf: git-delta 包）
# ============================================================
echo ""
if ! command -v delta &> /dev/null; then
    echo "📊 安装 git-delta..."
    case "$PKG_MANAGER" in
        apt) install_deb_from_release "dandavison/delta" "git-delta" 1 ;;
        dnf) sudo dnf install -y git-delta || true ;;
    esac
else
    echo "✅ delta 已安装"
fi

# ============================================================
# lsd（Ubuntu 通过 GitHub deb release）
# ============================================================
echo ""
if ! command -v lsd &> /dev/null; then
    echo "📂 安装 lsd..."
    case "$PKG_MANAGER" in
        apt) install_deb_from_release "lsd-rs/lsd" "lsd" 1 ;;
        dnf) sudo dnf install -y lsd || true ;;
    esac
else
    echo "✅ lsd 已安装"
fi

# ============================================================
# glow（Ubuntu 通过 charm.sh apt 源）
# ============================================================
echo ""
if ! command -v glow &> /dev/null; then
    echo "✨ 安装 glow..."
    case "$PKG_MANAGER" in
        apt)
            sudo mkdir -p /etc/apt/keyrings
            curl -fsSL --connect-timeout 10 --max-time 30 https://repo.charm.sh/apt/gpg.key | \
                sudo gpg --batch --yes --dearmor -o /etc/apt/keyrings/charm.gpg
            echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | \
                sudo tee /etc/apt/sources.list.d/charm.list
            sudo apt update && sudo apt install -y glow || true
            ;;
        dnf) sudo dnf install -y glow || true ;;
    esac
else
    echo "✅ glow 已安装"
fi

# ============================================================
# fx（GitHub release tar.gz）
# ============================================================
echo ""
if ! command -v fx &> /dev/null; then
    echo "📋 安装 fx..."
    if curl -fsSL --connect-timeout 10 --max-time 120 -o "$WORK_DIR/fx.tar.gz" \
        "https://github.com/antonmedv/fx/releases/latest/download/fx_linux_${ARCH_SUFFIX}.tar.gz"; then
        tar -xzf "$WORK_DIR/fx.tar.gz" -C "$WORK_DIR"
        sudo mv "$WORK_DIR/fx" /usr/local/bin/
    else
        echo "   ⚠️  fx 下载失败，跳过"
    fi
else
    echo "✅ fx 已安装"
fi

# ============================================================
# yazi（GitHub release zip 或 cargo）
# ============================================================
echo ""
if ! command -v yazi &> /dev/null; then
    echo "📁 安装 yazi..."
    YAZI_ARCH="${ARCH_ALT}-unknown-linux-musl"
    if curl -fsSL --connect-timeout 10 --max-time 120 -o "$WORK_DIR/yazi.zip" \
        "https://github.com/sxyazi/yazi/releases/latest/download/yazi-${YAZI_ARCH}.zip" 2>/dev/null; then
        unzip -o "$WORK_DIR/yazi.zip" -d "$WORK_DIR/yazi-tmp"
        sudo mv "$WORK_DIR/yazi-tmp/yazi-${YAZI_ARCH}/yazi" /usr/local/bin/
        sudo mv "$WORK_DIR/yazi-tmp/yazi-${YAZI_ARCH}/ya" /usr/local/bin/
    elif command -v cargo &> /dev/null; then
        cargo install --locked yazi-fm yazi-cli
    else
        echo "   ⚠️  无法安装 yazi（需要 cargo 或网络）"
    fi
else
    echo "✅ yazi 已安装"
fi

# ============================================================
# Zsh 插件
# ============================================================
if command -v zsh &> /dev/null; then
    echo ""
    echo "🔌 安装 Zsh 插件..."
    install_pkg zsh-syntax-highlighting zsh-syntax-highlighting zsh-syntax-highlighting
    install_pkg zsh-autosuggestions zsh-autosuggestions zsh-autosuggestions
fi

# ============================================================
# TPM
# ============================================================
echo ""
if [ ! -d ~/.tmux/plugins/tpm ]; then
    echo "📦 安装 TPM..."
    git clone --depth 1 https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
else
    echo "✅ TPM 已安装"
fi

# ============================================================
# Nerd Font
# ============================================================
echo ""
if ! fc-list 2>/dev/null | grep -qi "MesloLGS Nerd Font"; then
    echo "🔤 安装 MesloLGS Nerd Font..."
    mkdir -p ~/.local/share/fonts/Meslo
    if curl -fsSL --connect-timeout 10 --max-time 120 -o "$WORK_DIR/Meslo.tar.xz" \
        "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Meslo.tar.xz"; then
        tar -xf "$WORK_DIR/Meslo.tar.xz" -C ~/.local/share/fonts/Meslo
        fc-cache -f
    else
        echo "   ⚠️  Nerd Font 下载失败，跳过"
    fi
else
    echo "✅ Nerd Font 已安装"
fi

# ============================================================
# 完成
# ============================================================
echo ""
echo "══════════════════════════════════════════════════════════"
echo "✅ 所有依赖安装完成！"
echo "══════════════════════════════════════════════════════════"
echo ""
echo "📝 后续步骤："
echo "  1. 重新打开终端"
echo "  2. 启动 tmux 并按 Ctrl+s Shift+I 安装插件"
echo ""
{{ end -}}
