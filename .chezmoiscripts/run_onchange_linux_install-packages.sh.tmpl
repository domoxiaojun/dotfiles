{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# 此脚本在 Linux 上 chezmoi apply 时自动运行
# 用于安装必要的工具和依赖
# 支持: Fedora (dnf), Ubuntu/Debian (apt)
# version: 2.1.0

set -e

echo "🚀 开始安装依赖工具..."

# 创建临时目录，退出时自动清理
WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT

# 检测包管理器和发行版
DISTRO_ID=""
DISTRO_VERSION=""
if [ -f /etc/os-release ]; then
    . /etc/os-release
    DISTRO_ID="$ID"
    DISTRO_VERSION="$VERSION_ID"
fi

if command -v dnf &> /dev/null; then
    PKG_MANAGER="dnf"
    echo "📦 检测到 Fedora/RHEL 系 (dnf)"
    echo "   发行版: ${DISTRO_ID} ${DISTRO_VERSION}"
elif command -v apt &> /dev/null; then
    PKG_MANAGER="apt"
    echo "📦 检测到 Debian/Ubuntu 系 (apt)"
    echo "   发行版: ${DISTRO_ID} ${DISTRO_VERSION}"
else
    echo "⚠️  未检测到支持的包管理器 (apt/dnf)"
    exit 1
fi

# 检测系统架构
ARCH=$(uname -m)
case "$ARCH" in
    x86_64)
        ARCH_SUFFIX="amd64"
        ARCH_ALT="x86_64"
        ;;
    aarch64|arm64)
        ARCH_SUFFIX="arm64"
        ARCH_ALT="aarch64"
        ;;
    *)
        echo "⚠️  未支持的架构: $ARCH"
        ARCH_SUFFIX="amd64"
        ARCH_ALT="x86_64"
        ;;
esac

# 检测显示服务器 (Wayland vs X11)
DISPLAY_SERVER="unknown"
HAS_DESKTOP=false
if [ -n "$WAYLAND_DISPLAY" ]; then
    DISPLAY_SERVER="wayland"
    HAS_DESKTOP=true
elif [ -n "$DISPLAY" ]; then
    DISPLAY_SERVER="x11"
    HAS_DESKTOP=true
elif [ -n "$XDG_SESSION_TYPE" ]; then
    # 某些情况下环境变量可能未设置，但 XDG_SESSION_TYPE 可能有值
    DISPLAY_SERVER="$XDG_SESSION_TYPE"
    if [ "$XDG_SESSION_TYPE" = "wayland" ] || [ "$XDG_SESSION_TYPE" = "x11" ]; then
        HAS_DESKTOP=true
    fi
fi
if [ "$HAS_DESKTOP" = true ]; then
    echo "🖥️  桌面环境: $DISPLAY_SERVER"
else
    echo "🖥️  无桌面环境 (服务器/容器模式)"
fi

# ============================================================
# Fedora 专属: 启用常用 COPR 仓库
# ============================================================
if [ "$PKG_MANAGER" = "dnf" ]; then
    echo ""
    echo "📦 配置 Fedora 软件源..."

    # Ghostty COPR
    if ! dnf copr list 2>/dev/null | grep -q "scottames/ghostty"; then
        echo "   启用 Ghostty COPR..."
        sudo dnf copr enable -y scottames/ghostty
    fi
fi

# ============================================================
# 检查并安装 Git
# ============================================================
echo ""
echo "📦 检查 Git..."
if ! command -v git &> /dev/null; then
    echo "🔧 安装 Git..."
    if [ "$PKG_MANAGER" = "apt" ]; then
        sudo apt update
        sudo apt install -y git || true
    elif [ "$PKG_MANAGER" = "dnf" ]; then
        sudo dnf install -y git || true
    fi
else
    echo "✅ Git 已安装"
fi

# ============================================================
# 安装基础工具
# ============================================================
echo ""
echo "📦 安装基础工具..."
if [ "$PKG_MANAGER" = "apt" ]; then
    sudo apt install -y tmux fzf btop curl unzip fontconfig || true
elif [ "$PKG_MANAGER" = "dnf" ]; then
    sudo dnf install -y tmux fzf btop curl unzip fontconfig || true
fi

# ============================================================
# 安装剪贴板工具 (仅桌面环境)
# ============================================================
if [ "$HAS_DESKTOP" = true ]; then
    echo ""
    echo "📋 安装剪贴板工具..."
    if [ "$DISPLAY_SERVER" = "wayland" ] || [ "$DISTRO_ID" = "fedora" ]; then
        # Fedora 40+ 默认 Wayland，优先安装 wl-clipboard
        if ! command -v wl-copy &> /dev/null; then
            echo "   安装 wl-clipboard (Wayland)..."
            if [ "$PKG_MANAGER" = "dnf" ]; then
                sudo dnf install -y wl-clipboard || true
            elif [ "$PKG_MANAGER" = "apt" ]; then
                sudo apt install -y wl-clipboard || true
            fi
        else
            echo "   ✅ wl-clipboard 已安装"
        fi
    else
        # X11 环境安装 xclip
        if ! command -v xclip &> /dev/null; then
            echo "   安装 xclip (X11)..."
            if [ "$PKG_MANAGER" = "dnf" ]; then
                sudo dnf install -y xclip || true
            elif [ "$PKG_MANAGER" = "apt" ]; then
                sudo apt install -y xclip || true
            fi
        else
            echo "   ✅ xclip 已安装"
        fi
    fi
else
    echo ""
    echo "📋 跳过剪贴板工具 (无桌面环境)"
fi

# ============================================================
# 安装 Ghostty
# ============================================================
echo ""
if ! command -v ghostty &> /dev/null; then
    echo "👻 安装 Ghostty..."
    if [ "$PKG_MANAGER" = "apt" ]; then
        # Ubuntu: 使用社区维护的安装脚本
        /bin/bash -c "$(curl -fsSL --connect-timeout 10 --max-time 120 https://raw.githubusercontent.com/mkasberg/ghostty-ubuntu/HEAD/install.sh)" || true
    elif [ "$PKG_MANAGER" = "dnf" ]; then
        # Fedora: 使用 COPR (已在上面启用)
        sudo dnf install -y ghostty || true
    fi
else
    echo "✅ Ghostty 已安装"
fi

# ============================================================
# 安装 Starship
# ============================================================
echo ""
if ! command -v starship &> /dev/null; then
    echo "🚀 安装 Starship..."
    curl -sS --connect-timeout 10 --max-time 60 https://starship.rs/install.sh | sh -s -- -y || true
else
    echo "✅ Starship 已安装"
fi

# ============================================================
# 安装 bat
# ============================================================
echo ""
if ! command -v bat &> /dev/null && ! command -v batcat &> /dev/null; then
    echo "🦇 安装 bat..."
    if [ "$PKG_MANAGER" = "apt" ]; then
        sudo apt install -y bat || true
    elif [ "$PKG_MANAGER" = "dnf" ]; then
        sudo dnf install -y bat || true
    fi
else
    echo "✅ bat 已安装"
fi

# ============================================================
# 安装 lsd
# ============================================================
echo ""
if ! command -v lsd &> /dev/null; then
    echo "📂 安装 lsd..."
    if [ "$PKG_MANAGER" = "apt" ]; then
        # lsd 不在默认 apt 源中，使用 dpkg
        LSD_VERSION=$(curl -s --connect-timeout 10 --max-time 30 https://api.github.com/repos/lsd-rs/lsd/releases/latest | grep -o '"tag_name": "[^"]*"' | head -1 | cut -d'"' -f4 | sed 's/^v//')
        if [ -z "$LSD_VERSION" ]; then
            echo "   ⚠️  无法获取 lsd 最新版本号，跳过安装"
        else
            curl -fsSL --connect-timeout 10 --max-time 120 -o "$WORK_DIR/lsd.deb" "https://github.com/lsd-rs/lsd/releases/latest/download/lsd_${LSD_VERSION}_${ARCH_SUFFIX}.deb"
            sudo dpkg -i "$WORK_DIR/lsd.deb" || true
        fi
    elif [ "$PKG_MANAGER" = "dnf" ]; then
        sudo dnf install -y lsd || true
    fi
else
    echo "✅ lsd 已安装"
fi

# ============================================================
# 安装 delta (git diff 美化)
# ============================================================
echo ""
if ! command -v delta &> /dev/null; then
    echo "📊 安装 git-delta..."
    if [ "$PKG_MANAGER" = "apt" ]; then
        DELTA_VERSION=$(curl -s --connect-timeout 10 --max-time 30 https://api.github.com/repos/dandavison/delta/releases/latest | grep -o '"tag_name": "[^"]*"' | head -1 | cut -d'"' -f4 | sed 's/^v//')
        if [ -z "$DELTA_VERSION" ]; then
            echo "   ⚠️  无法获取 delta 最新版本号，跳过安装"
        else
            curl -fsSL --connect-timeout 10 --max-time 120 -o "$WORK_DIR/delta.deb" "https://github.com/dandavison/delta/releases/latest/download/git-delta_${DELTA_VERSION}_${ARCH_SUFFIX}.deb"
            sudo dpkg -i "$WORK_DIR/delta.deb" || true
        fi
    elif [ "$PKG_MANAGER" = "dnf" ]; then
        sudo dnf install -y git-delta || true
    fi
else
    echo "✅ delta 已安装"
fi

# ============================================================
# 安装 glow (Markdown 渲染)
# ============================================================
echo ""
if ! command -v glow &> /dev/null; then
    echo "✨ 安装 glow..."
    if [ "$PKG_MANAGER" = "apt" ]; then
        sudo mkdir -p /etc/apt/keyrings
        curl -fsSL --connect-timeout 10 --max-time 30 https://repo.charm.sh/apt/gpg.key | sudo gpg --batch --yes --dearmor -o /etc/apt/keyrings/charm.gpg
        echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | sudo tee /etc/apt/sources.list.d/charm.list
        sudo apt update && sudo apt install -y glow || true
    elif [ "$PKG_MANAGER" = "dnf" ]; then
        sudo dnf install -y glow || true
    fi
else
    echo "✅ glow 已安装"
fi

# ============================================================
# 安装 fd (更好的 find)
# ============================================================
echo ""
if ! command -v fd &> /dev/null && ! command -v fdfind &> /dev/null; then
    echo "🔍 安装 fd..."
    if [ "$PKG_MANAGER" = "apt" ]; then
        sudo apt install -y fd-find || true
    elif [ "$PKG_MANAGER" = "dnf" ]; then
        sudo dnf install -y fd-find || true
    fi
else
    echo "✅ fd 已安装"
fi

# ============================================================
# 安装 ripgrep (更好的 grep)
# ============================================================
echo ""
if ! command -v rg &> /dev/null; then
    echo "🔎 安装 ripgrep..."
    if [ "$PKG_MANAGER" = "apt" ]; then
        sudo apt install -y ripgrep || true
    elif [ "$PKG_MANAGER" = "dnf" ]; then
        sudo dnf install -y ripgrep || true
    fi
else
    echo "✅ ripgrep 已安装"
fi

# ============================================================
# 安装 fx (JSON 交互查看器)
# ============================================================
echo ""
if ! command -v fx &> /dev/null; then
    echo "📋 安装 fx..."
    FX_VERSION=$(curl -s --connect-timeout 10 --max-time 30 https://api.github.com/repos/antonmedv/fx/releases/latest | grep -o '"tag_name": "[^"]*"' | head -1 | cut -d'"' -f4)
    if [ -n "$FX_VERSION" ]; then
        curl -fsSL --connect-timeout 10 --max-time 120 -o "$WORK_DIR/fx.tar.gz" "https://github.com/antonmedv/fx/releases/latest/download/fx_linux_${ARCH_SUFFIX}.tar.gz"
        tar -xzf "$WORK_DIR/fx.tar.gz" -C "$WORK_DIR"
        sudo mv "$WORK_DIR/fx" /usr/local/bin/
    else
        echo "   ⚠️  无法获取 fx 版本号，跳过安装"
    fi
else
    echo "✅ fx 已安装"
fi

# ============================================================
# 安装 yazi (终端文件管理器)
# ============================================================
echo ""
if ! command -v yazi &> /dev/null; then
    echo "📁 安装 yazi..."
    # 优先使用预编译二进制，cargo 编译耗时长
    YAZI_VERSION=$(curl -s --connect-timeout 10 --max-time 30 https://api.github.com/repos/sxyazi/yazi/releases/latest | grep -o '"tag_name": "[^"]*"' | head -1 | cut -d'"' -f4 | sed 's/^v//')
    YAZI_ARCH="${ARCH_ALT}-unknown-linux-musl"
    if [ -n "$YAZI_VERSION" ] && curl -fsSL --connect-timeout 10 --max-time 120 -o "$WORK_DIR/yazi.zip" "https://github.com/sxyazi/yazi/releases/latest/download/yazi-${YAZI_ARCH}.zip" 2>/dev/null; then
        unzip -o "$WORK_DIR/yazi.zip" -d "$WORK_DIR/yazi-tmp"
        sudo mv "$WORK_DIR/yazi-tmp/yazi-${YAZI_ARCH}/yazi" /usr/local/bin/
        sudo mv "$WORK_DIR/yazi-tmp/yazi-${YAZI_ARCH}/ya" /usr/local/bin/
    elif command -v cargo &> /dev/null; then
        cargo install --locked yazi-fm yazi-cli
    else
        echo "   ⚠️  无法安装 yazi（需要 cargo 或网络连接）"
    fi
else
    echo "✅ yazi 已安装"
fi

# ============================================================
# 安装 zsh 插件 (仅在 zsh 已安装时)
# ============================================================
echo ""
if command -v zsh &> /dev/null; then
    echo "🔌 安装 Zsh 插件..."
    if [ "$PKG_MANAGER" = "apt" ]; then
        sudo apt install -y zsh-syntax-highlighting zsh-autosuggestions || true
    elif [ "$PKG_MANAGER" = "dnf" ]; then
        sudo dnf install -y zsh-syntax-highlighting zsh-autosuggestions || true
    fi
else
    echo "📋 跳过 Zsh 插件 (zsh 未安装)"
fi

# ============================================================
# 安装 TPM（Tmux 插件管理器）
# ============================================================
echo ""
if [ ! -d ~/.tmux/plugins/tpm ]; then
    echo "📦 安装 TPM (Tmux Plugin Manager)..."
    git clone --depth 1 https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
else
    echo "✅ TPM 已安装"
fi

# ============================================================
# 安装 Nerd Font
# ============================================================
echo ""
if ! fc-list 2>/dev/null | grep -qi "MesloLGS Nerd Font"; then
    echo "🔤 安装 MesloLGS Nerd Font..."
    mkdir -p ~/.local/share/fonts
    if curl -fsSL --connect-timeout 10 --max-time 120 -o "$WORK_DIR/Meslo.tar.xz" "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Meslo.tar.xz"; then
        tar -xf "$WORK_DIR/Meslo.tar.xz" -C ~/.local/share/fonts
        fc-cache -f
    else
        echo "   ⚠️  Nerd Font 下载失败，跳过"
    fi
else
    echo "✅ Nerd Font 已安装"
fi

# ============================================================
# 完成提示
# ============================================================
echo ""
echo "══════════════════════════════════════════════════════════"
echo "✅ 所有依赖安装完成！"
echo "══════════════════════════════════════════════════════════"
echo ""
echo "📝 后续步骤："
echo "  1. 重新打开终端（或新开一个 Ghostty 窗口）"
echo "  2. 启动 tmux 并按 Ctrl+s Shift+I 安装插件"
echo "  3. 享受你的新终端环境！"
echo ""
if [ "$DISTRO_ID" = "fedora" ]; then
    echo "🎩 Fedora 用户提示："
    echo "  - 剪贴板: 已安装 wl-clipboard (Wayland)"
    echo "  - 终端: Ghostty 来自 COPR (scottames/ghostty)"
    echo ""
fi
{{ end -}}
