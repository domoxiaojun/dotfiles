{{ if eq .chezmoi.os "windows" -}}
#!/usr/bin/env pwsh
# Windows package install script
# Runs automatically on chezmoi apply
# version: 1.1.0

$ErrorActionPreference = 'Stop'
try {

    Write-Host "Installing Windows terminal tools..." -ForegroundColor Cyan

    # Check and install Scoop
    if (-not (Get-Command scoop -ErrorAction SilentlyContinue) -and -not (Test-Path "$env:USERPROFILE\scoop")) {
        Write-Host "Scoop not found, installing..." -ForegroundColor Yellow
        Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
        Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression
    }
    else {
        Write-Host "[OK] Scoop installed" -ForegroundColor Green
    }

    # Ensure Scoop is available in current session
    $env:PATH = "$env:USERPROFILE\scoop\shims;$env:PATH"

    # Add extras bucket
    scoop bucket add extras 2>$null

    # Install latest PowerShell (pwsh)
    if (-not (Get-Command pwsh -ErrorAction SilentlyContinue)) {
        Write-Host "Installing PowerShell 7..." -ForegroundColor Yellow
        scoop install pwsh
    }
    else {
        Write-Host "[OK] PowerShell 7 installed" -ForegroundColor Green
    }

    # Set PowerShell 7 as default in Windows Terminal
    $wtSettingsPath = "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json"
    if (Test-Path $wtSettingsPath) {
        Write-Host "Setting PowerShell 7 as default terminal..." -ForegroundColor Yellow
        $wtSettings = Get-Content $wtSettingsPath -Raw | ConvertFrom-Json
        
        # Find pwsh profile guid
        $pwshProfile = $wtSettings.profiles.list | Where-Object { $_.name -like "*PowerShell*" -and $_.source -eq "Windows.Terminal.PowershellCore" }
        if ($pwshProfile) {
            $wtSettings.defaultProfile = $pwshProfile.guid
            $wtSettings | ConvertTo-Json -Depth 100 | Set-Content $wtSettingsPath -Encoding UTF8
            Write-Host "[OK] PowerShell 7 set as default" -ForegroundColor Green
        }
        else {
            Write-Host "[WARN] PowerShell 7 profile not found in Windows Terminal, please set manually" -ForegroundColor Yellow
        }
    }
    else {
        Write-Host "[INFO] Windows Terminal not found, skipping default shell setting" -ForegroundColor Gray
    }

    # Check and install Git first
    Write-Host "Checking Git..." -ForegroundColor Yellow
    if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
        Write-Host "  Installing Git..." -ForegroundColor Gray
        scoop install git
    }
    else {
        Write-Host "  [OK] Git installed" -ForegroundColor Green
    }

    # Install core tools
    Write-Host "Installing terminal tools..." -ForegroundColor Yellow
    $tools = @("starship", "lsd", "bat", "delta", "btop", "glow", "fzf", "yazi", "fd", "ripgrep", "jq")
    foreach ($tool in $tools) {
        if (-not (Get-Command $tool -ErrorAction SilentlyContinue)) {
            Write-Host "  Installing $tool..." -ForegroundColor Gray
            scoop install $tool
        }
        else {
            Write-Host "  [OK] $tool installed" -ForegroundColor Green
        }
    }

    # Configure YAZI_FILE_ONE for yazi file type detection (uses Git's file.exe)
    Write-Host ""
    Write-Host "Configuring YAZI_FILE_ONE environment variable..." -ForegroundColor Yellow
    $gitPath = (Get-Command git -ErrorAction SilentlyContinue).Source
    if ($gitPath) {
        $gitRoot = Split-Path (Split-Path $gitPath)
        $fileExePath = Join-Path $gitRoot "usr\bin\file.exe"
        
        if (Test-Path $fileExePath) {
            [System.Environment]::SetEnvironmentVariable("YAZI_FILE_ONE", $fileExePath, "User")
            $env:YAZI_FILE_ONE = $fileExePath
            Write-Host "  [OK] YAZI_FILE_ONE set to: $fileExePath" -ForegroundColor Green
        }
        else {
            Write-Host "  [WARN] file.exe not found at: $fileExePath" -ForegroundColor Yellow
            Write-Host "         yazi may not detect file types correctly" -ForegroundColor Yellow
        }
    }
    else {
        Write-Host "  [WARN] Git not found, YAZI_FILE_ONE not configured" -ForegroundColor Yellow
    }

    # Install Nerd Font
    Write-Host "Installing Nerd Font..." -ForegroundColor Yellow
    scoop bucket add nerd-fonts 2>$null
    scoop install Meslo-NF-Mono 2>$null

    Write-Host ""
    Write-Host "[OK] All dependencies installed!" -ForegroundColor Green

    # Sync PowerShell Profile
    $SourceProfile = Join-Path (Split-Path -Parent $PSScriptRoot) "Documents\PowerShell\Microsoft.PowerShell_profile.ps1"
    if (Test-Path $SourceProfile) {
        Write-Host "Syncing Profile to $PROFILE ..." -ForegroundColor Cyan
        New-Item -ItemType Directory -Force -Path (Split-Path $PROFILE) | Out-Null
        Copy-Item $SourceProfile $PROFILE -Force
    }

    Write-Host ""
    Write-Host "Next steps:" -ForegroundColor Cyan
    Write-Host "  1. Restart PowerShell"
    Write-Host "  2. Set 'MesloLGS NF' font in Windows Terminal settings"
    Write-Host "  3. Enjoy your new terminal!"

    exit 0

}
catch {
    Write-Host "Error: $_" -ForegroundColor Red
    Write-Host "Please check the error and retry" -ForegroundColor Yellow
    exit 1
}
{{ end -}}
