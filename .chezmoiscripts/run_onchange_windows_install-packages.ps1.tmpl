{{ if eq .chezmoi.os "windows" -}}
#!/usr/bin/env pwsh
# Windows 包安装脚本
# chezmoi apply 时自动执行
# version: 2.2.0
#
# 修改记录:
#   2.2.0 - 修复 scoop update 错误检测、Git 路径推断、exit code 处理
#   2.1.0 - 添加安装结果跟踪和汇总报告
#   2.0.0 - 修复 Scoop 路径硬编码、工具列表补全、容错机制、字体包名

# 全局错误处理：仅对关键步骤使用 Stop，工具安装区域使用 Continue
$ErrorActionPreference = 'Stop'

# ============================================================
# 安装结果跟踪
# ============================================================
$script:Results = @{
    Success  = [System.Collections.ArrayList]::new()
    Failed   = [System.Collections.ArrayList]::new()
    Skipped  = [System.Collections.ArrayList]::new()
}

function Add-Result {
    param([string]$Name, [string]$Status, [string]$Detail = "", [string]$ScoopName = "")
    switch ($Status) {
        'success'  { [void]$script:Results.Success.Add(@{ Name = $Name; Detail = $Detail; ScoopName = $ScoopName }) }
        'failed'   { [void]$script:Results.Failed.Add(@{ Name = $Name; Detail = $Detail; ScoopName = $ScoopName }) }
        'skipped'  { [void]$script:Results.Skipped.Add(@{ Name = $Name; Detail = $Detail; ScoopName = $ScoopName }) }
    }
}

Write-Host "`n========================================" -ForegroundColor Cyan
Write-Host "  Windows 终端工具安装脚本 v2.2.0" -ForegroundColor Cyan
Write-Host "========================================`n" -ForegroundColor Cyan

# ============================================================
# 辅助函数
# ============================================================

function Install-ScoopPackage {
    param(
        [string]$Name,
        [string]$DisplayName = $Name,
        [string]$CommandName = $Name
    )
    if (Get-Command $CommandName -ErrorAction SilentlyContinue) {
        Write-Host "  [OK] $DisplayName 已安装" -ForegroundColor Green
        Add-Result -Name $DisplayName -Status 'skipped' -Detail '已安装' -ScoopName $Name
        return
    }
    Write-Host "  安装 $DisplayName ..." -ForegroundColor Gray
    try {
        $output = scoop install $Name 2>&1
        $exitCode = $LASTEXITCODE
        $output | Out-Host

        # 再次检查命令是否可用（scoop 可能报 warning 但实际安装成功）
        if (Get-Command $CommandName -ErrorAction SilentlyContinue) {
            Write-Host "  [OK] $DisplayName 安装完成" -ForegroundColor Green
            Add-Result -Name $DisplayName -Status 'success' -ScoopName $Name
        }
        elseif ($exitCode -eq 0) {
            Write-Host "  [OK] $DisplayName 安装完成（需重启终端生效）" -ForegroundColor Green
            Add-Result -Name $DisplayName -Status 'success' -Detail '需重启终端' -ScoopName $Name
        }
        else {
            Write-Host "  [WARN] $DisplayName 安装可能未成功 (exit: $exitCode)" -ForegroundColor Yellow
            $errorMsg = ($output | Where-Object { $_ -match 'Error|error' } | Select-Object -First 1) -as [string]
            Add-Result -Name $DisplayName -Status 'failed' -Detail ($errorMsg ?? "exit code: $exitCode") -ScoopName $Name
        }
    }
    catch {
        Write-Host "  [FAIL] $DisplayName 安装失败: $_" -ForegroundColor Red
        Add-Result -Name $DisplayName -Status 'failed' -Detail "$_" -ScoopName $Name
    }
}

# ============================================================
# 1. 检测 / 安装 Scoop（动态路径）
# ============================================================
Write-Host "[1/8] 检查 Scoop ..." -ForegroundColor Cyan

$ScoopDir = if ($env:SCOOP) { $env:SCOOP } else { "$env:USERPROFILE\scoop" }

if (-not (Get-Command scoop -ErrorAction SilentlyContinue) -and -not (Test-Path $ScoopDir)) {
    Write-Host "  Scoop 未安装，正在安装..." -ForegroundColor Yellow
    try {
        Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
        Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression
        Add-Result -Name 'Scoop' -Status 'success'
    }
    catch {
        Write-Host "  [FAIL] Scoop 安装失败: $_" -ForegroundColor Red
        Add-Result -Name 'Scoop' -Status 'failed' -Detail "$_"
        Write-Host "`n无法继续安装，Scoop 是所有工具的前置依赖。" -ForegroundColor Red
        exit 1
    }
}
else {
    Write-Host "  [OK] Scoop 已安装 ($ScoopDir)" -ForegroundColor Green
    Add-Result -Name 'Scoop' -Status 'skipped' -Detail '已安装'
}

# 确保 Scoop shims 在当前会话的 PATH 中
$env:PATH = "$ScoopDir\shims;$env:PATH"

# ============================================================
# 2. 确保 Git 可用（scoop bucket 的前置依赖）
# ============================================================
Write-Host "`n[2/8] 检查 Git（Scoop 前置依赖）..." -ForegroundColor Cyan

if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
    Write-Host "  Git 未安装，正在通过 Scoop 安装..." -ForegroundColor Yellow
    try {
        scoop install git
        if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
            throw "安装后 git 命令仍不可用"
        }
        Add-Result -Name 'Git' -Status 'success'
    }
    catch {
        Write-Host "  [FAIL] Git 安装失败: $_" -ForegroundColor Red
        Add-Result -Name 'Git' -Status 'failed' -Detail "$_"
        Write-Host "`n无法继续安装，Git 是 Scoop bucket 的前置依赖。" -ForegroundColor Red
        exit 1
    }
}
else {
    Write-Host "  [OK] Git 已安装" -ForegroundColor Green
    Add-Result -Name 'Git' -Status 'skipped' -Detail '已安装'
}

# ============================================================
# 3. 添加 Scoop buckets
# ============================================================
Write-Host "`n[3/8] 配置 Scoop buckets ..." -ForegroundColor Cyan

$buckets = scoop bucket list 2>$null | Select-Object -ExpandProperty Name -ErrorAction SilentlyContinue
foreach ($bucket in @('extras', 'nerd-fonts')) {
    if ($buckets -notcontains $bucket) {
        Write-Host "  添加 $bucket bucket ..." -ForegroundColor Gray
        try {
            scoop bucket add $bucket
            Add-Result -Name "Bucket: $bucket" -Status 'success'
        }
        catch {
            Write-Host "  [WARN] $bucket bucket 添加失败: $_" -ForegroundColor Yellow
            Add-Result -Name "Bucket: $bucket" -Status 'failed' -Detail "$_"
        }
    }
    else {
        Write-Host "  [OK] $bucket bucket 已存在" -ForegroundColor Green
        Add-Result -Name "Bucket: $bucket" -Status 'skipped' -Detail '已存在'
    }
}

# ============================================================
# 4. 安装 PowerShell 7 并配置 Windows Terminal
# ============================================================
Write-Host "`n[4/8] 检查 PowerShell 7 ..." -ForegroundColor Cyan

if (-not (Get-Command pwsh -ErrorAction SilentlyContinue)) {
    Write-Host "  安装 PowerShell 7 ..." -ForegroundColor Yellow
    try {
        scoop install pwsh
        if (Get-Command pwsh -ErrorAction SilentlyContinue) {
            Add-Result -Name 'PowerShell 7' -Status 'success'
        } else {
            Add-Result -Name 'PowerShell 7' -Status 'success' -Detail '需重启终端'
        }
    }
    catch {
        Write-Host "  [WARN] PowerShell 7 安装失败: $_" -ForegroundColor Yellow
        Add-Result -Name 'PowerShell 7' -Status 'failed' -Detail "$_"
    }
}
else {
    Write-Host "  [OK] PowerShell 7 已安装" -ForegroundColor Green
    Add-Result -Name 'PowerShell 7' -Status 'skipped' -Detail '已安装'
}

# 设置 PowerShell 7 为 Windows Terminal 默认
$wtSettingsPath = "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json"
if (Test-Path $wtSettingsPath) {
    Write-Host "  配置 Windows Terminal 默认 shell ..." -ForegroundColor Gray
    try {
        $wtSettings = Get-Content $wtSettingsPath -Raw | ConvertFrom-Json

        # 查找 pwsh profile guid
        $pwshProfile = $wtSettings.profiles.list | Where-Object {
            $_.name -like "*PowerShell*" -and $_.source -eq "Windows.Terminal.PowershellCore"
        }
        if ($pwshProfile) {
            $wtSettings.defaultProfile = $pwshProfile.guid
            $wtSettings | ConvertTo-Json -Depth 100 | Set-Content $wtSettingsPath -Encoding UTF8
            Write-Host "  [OK] PowerShell 7 已设为默认 shell" -ForegroundColor Green
        }
        else {
            Write-Host "  [INFO] 未找到 PowerShell 7 profile，请手动设置" -ForegroundColor Yellow
        }
    }
    catch {
        Write-Host "  [WARN] 配置 Windows Terminal 失败: $_" -ForegroundColor Yellow
    }
}
else {
    Write-Host "  [INFO] 未检测到 Windows Terminal，跳过默认 shell 设置" -ForegroundColor Gray
}

# ============================================================
# 5. 安装终端工具（容错：单个失败不影响后续）
# ============================================================
Write-Host "`n[5/8] 安装终端工具 ..." -ForegroundColor Cyan

# 临时降低错误级别，避免 scoop 内部错误中断脚本
$ErrorActionPreference = 'Continue'

# 先统一更新 Scoop，避免每次 install 都触发 Updating Scoop 导致失败
Write-Host "  更新 Scoop 索引 ..." -ForegroundColor Gray
scoop update 2>&1 | Out-Null
if ($LASTEXITCODE -ne 0) {
    Write-Host "  [WARN] Scoop 更新失败，继续安装 ..." -ForegroundColor Yellow
} else {
    Write-Host "  [OK] Scoop 索引已更新" -ForegroundColor Green
}

# 核心工具列表
Install-ScoopPackage -Name "starship" -DisplayName "Starship (prompt)"
Install-ScoopPackage -Name "lsd" -DisplayName "lsd (彩色 ls)"
Install-ScoopPackage -Name "bat" -DisplayName "bat (彩色 cat)"
Install-ScoopPackage -Name "delta" -DisplayName "delta (git diff 美化)"
Install-ScoopPackage -Name "btop" -DisplayName "btop (系统监控)"
Install-ScoopPackage -Name "glow" -DisplayName "glow (Markdown 渲染)"
Install-ScoopPackage -Name "fzf" -DisplayName "fzf (模糊搜索)"
Install-ScoopPackage -Name "yazi" -DisplayName "yazi (文件管理器)"
Install-ScoopPackage -Name "fd" -DisplayName "fd (更好的 find)"
Install-ScoopPackage -Name "ripgrep" -DisplayName "ripgrep (更好的 grep)" -CommandName "rg"
Install-ScoopPackage -Name "fx" -DisplayName "fx (JSON 查看器)"

# 恢复错误级别
$ErrorActionPreference = 'Stop'

# ============================================================
# 6. 配置 YAZI_FILE_ONE（yazi 文件类型检测）
# ============================================================
Write-Host "`n[6/8] 配置 YAZI_FILE_ONE 环境变量 ..." -ForegroundColor Cyan

$fileExePath = $null

# 优先使用 git --exec-path 获取真实安装路径（避免 Scoop shim 路径问题）
$gitExecPath = & git --exec-path 2>$null
if ($gitExecPath) {
    $gitRoot = Split-Path (Split-Path $gitExecPath)
    $candidate = Join-Path $gitRoot "usr\bin\file.exe"
    if (Test-Path $candidate) { $fileExePath = $candidate }
}

# 回退: 尝试 scoop prefix git
if (-not $fileExePath -and (Get-Command scoop -ErrorAction SilentlyContinue)) {
    $scoopGitPrefix = & scoop prefix git 2>$null
    if ($scoopGitPrefix) {
        $candidate = Join-Path $scoopGitPrefix "usr\bin\file.exe"
        if (Test-Path $candidate) { $fileExePath = $candidate }
    }
}

if ($fileExePath) {
    [System.Environment]::SetEnvironmentVariable("YAZI_FILE_ONE", $fileExePath, "User")
    $env:YAZI_FILE_ONE = $fileExePath
    Write-Host "  [OK] YAZI_FILE_ONE = $fileExePath" -ForegroundColor Green
    Add-Result -Name 'YAZI_FILE_ONE' -Status 'success'
}
elseif (Get-Command git -ErrorAction SilentlyContinue) {
    Write-Host "  [WARN] file.exe 未找到，yazi 可能无法正确检测文件类型" -ForegroundColor Yellow
    Add-Result -Name 'YAZI_FILE_ONE' -Status 'failed' -Detail "file.exe 未找到"
}
else {
    Write-Host "  [WARN] Git 未安装，跳过 YAZI_FILE_ONE 配置" -ForegroundColor Yellow
    Add-Result -Name 'YAZI_FILE_ONE' -Status 'skipped' -Detail 'Git 未安装'
}

# ============================================================
# 7. 安装 Nerd Font
# ============================================================
Write-Host "`n[7/8] 安装 Nerd Font ..." -ForegroundColor Cyan

# 检查字体是否已安装（查注册表 + 用户字体目录 + Scoop 目录）
$fontInstalled = $false

$sysFonts = Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts' -ErrorAction SilentlyContinue
if ($sysFonts) {
    foreach ($font in $sysFonts.PSObject.Properties) {
        if ($font.Name -like "*Meslo*Nerd*") { $fontInstalled = $true; break }
    }
}
if (-not $fontInstalled) {
    $userFontPath = "$env:LOCALAPPDATA\Microsoft\Windows\Fonts"
    if (Test-Path "$userFontPath\*Meslo*Nerd*") { $fontInstalled = $true }
}
if (-not $fontInstalled) {
    if (Test-Path "$ScoopDir\apps\Meslo-NF") { $fontInstalled = $true }
}

if ($fontInstalled) {
    Write-Host "  [OK] Meslo Nerd Font 已安装" -ForegroundColor Green
    Add-Result -Name 'Meslo Nerd Font' -Status 'skipped' -Detail '已安装'
}
else {
    Write-Host "  安装 Meslo Nerd Font ..." -ForegroundColor Gray
    try {
        $output = scoop install Meslo-NF 2>&1
        $output | Out-Host
        if (Test-Path "$ScoopDir\apps\Meslo-NF") {
            Write-Host "  [OK] Meslo Nerd Font 安装完成" -ForegroundColor Green
            Add-Result -Name 'Meslo Nerd Font' -Status 'success'
        }
        else {
            Write-Host "  [WARN] Meslo Nerd Font 安装可能未成功" -ForegroundColor Yellow
            Add-Result -Name 'Meslo Nerd Font' -Status 'failed' -Detail '安装后未检测到字体文件'
        }
    }
    catch {
        Write-Host "  [FAIL] 字体安装失败: $_" -ForegroundColor Red
        Add-Result -Name 'Meslo Nerd Font' -Status 'failed' -Detail "$_"
    }
}

# ============================================================
# 8. 安装报告
# ============================================================
Write-Host "`n`n" -NoNewline
Write-Host "╔══════════════════════════════════════════════════╗" -ForegroundColor Cyan
Write-Host "║             安 装 报 告                         ║" -ForegroundColor Cyan
Write-Host "╠══════════════════════════════════════════════════╣" -ForegroundColor Cyan

# 已安装（跳过）
if ($script:Results.Skipped.Count -gt 0) {
    Write-Host "║" -ForegroundColor Cyan -NoNewline
    Write-Host "  ✅ 已安装 ($($script:Results.Skipped.Count)):" -ForegroundColor Green -NoNewline
    Write-Host (" " * (49 - 17 - "$($script:Results.Skipped.Count)".Length)) -NoNewline
    Write-Host "║" -ForegroundColor Cyan
    foreach ($item in $script:Results.Skipped) {
        $line = "     $($item.Name)"
        $pad = 49 - $line.Length
        if ($pad -lt 1) { $pad = 1 }
        Write-Host "║" -ForegroundColor Cyan -NoNewline
        Write-Host $line -ForegroundColor Gray -NoNewline
        Write-Host (" " * $pad) -NoNewline
        Write-Host "║" -ForegroundColor Cyan
    }
}

# 新安装成功
if ($script:Results.Success.Count -gt 0) {
    Write-Host "║" -ForegroundColor Cyan -NoNewline
    Write-Host "  🆕 新安装 ($($script:Results.Success.Count)):" -ForegroundColor Green -NoNewline
    Write-Host (" " * (49 - 17 - "$($script:Results.Success.Count)".Length)) -NoNewline
    Write-Host "║" -ForegroundColor Cyan
    foreach ($item in $script:Results.Success) {
        $detail = if ($item.Detail) { " ($($item.Detail))" } else { "" }
        $line = "     $($item.Name)$detail"
        $pad = 49 - $line.Length
        if ($pad -lt 1) { $pad = 1 }
        Write-Host "║" -ForegroundColor Cyan -NoNewline
        Write-Host $line -ForegroundColor White -NoNewline
        Write-Host (" " * $pad) -NoNewline
        Write-Host "║" -ForegroundColor Cyan
    }
}

# 安装失败
if ($script:Results.Failed.Count -gt 0) {
    Write-Host "║" -ForegroundColor Cyan -NoNewline
    Write-Host "  ❌ 失败 ($($script:Results.Failed.Count)):" -ForegroundColor Red -NoNewline
    Write-Host (" " * (49 - 14 - "$($script:Results.Failed.Count)".Length)) -NoNewline
    Write-Host "║" -ForegroundColor Cyan
    foreach ($item in $script:Results.Failed) {
        $line = "     $($item.Name)"
        $pad = 49 - $line.Length
        if ($pad -lt 1) { $pad = 1 }
        Write-Host "║" -ForegroundColor Cyan -NoNewline
        Write-Host $line -ForegroundColor Red -NoNewline
        Write-Host (" " * $pad) -NoNewline
        Write-Host "║" -ForegroundColor Cyan

        if ($item.Detail) {
            $detailLine = "       → $($item.Detail)"
            if ($detailLine.Length -gt 49) { $detailLine = $detailLine.Substring(0, 46) + "..." }
            $pad2 = 49 - $detailLine.Length
            if ($pad2 -lt 1) { $pad2 = 1 }
            Write-Host "║" -ForegroundColor Cyan -NoNewline
            Write-Host $detailLine -ForegroundColor DarkGray -NoNewline
            Write-Host (" " * $pad2) -NoNewline
            Write-Host "║" -ForegroundColor Cyan
        }
    }
}

Write-Host "╠══════════════════════════════════════════════════╣" -ForegroundColor Cyan

# 总结行
$total = $script:Results.Success.Count + $script:Results.Failed.Count + $script:Results.Skipped.Count
if ($script:Results.Failed.Count -eq 0) {
    $summaryText = "  全部完成！共 $total 项，无失败"
    $summaryColor = "Green"
}
else {
    $summaryText = "  共 $total 项: $($script:Results.Success.Count) 新装, $($script:Results.Failed.Count) 失败, $($script:Results.Skipped.Count) 已有"
    $summaryColor = "Yellow"
}
$pad3 = 49 - $summaryText.Length
if ($pad3 -lt 1) { $pad3 = 1 }
Write-Host "║" -ForegroundColor Cyan -NoNewline
Write-Host $summaryText -ForegroundColor $summaryColor -NoNewline
Write-Host (" " * $pad3) -NoNewline
Write-Host "║" -ForegroundColor Cyan

Write-Host "╚══════════════════════════════════════════════════╝" -ForegroundColor Cyan

# 失败项重试指南
if ($script:Results.Failed.Count -gt 0) {
    Write-Host ""
    Write-Host "💡 修复建议:" -ForegroundColor Yellow
    foreach ($item in $script:Results.Failed) {
        $scoopPkg = if ($item.ScoopName) { $item.ScoopName } else { $item.Name -replace '\s*\(.*\)', '' }
        Write-Host "   scoop install $scoopPkg" -ForegroundColor White
    }
    Write-Host ""
    Write-Host "   或重新运行: chezmoi apply" -ForegroundColor Gray
}

# 后续步骤
Write-Host ""
Write-Host "📝 后续步骤:" -ForegroundColor Cyan
Write-Host "  1. 重启 PowerShell / Windows Terminal"
Write-Host "  2. 在 Windows Terminal 设置中将字体设为 'MesloLGS Nerd Font'"
Write-Host "  3. 享受你的新终端环境！"
Write-Host ""

# 非关键工具失败不应阻止 chezmoi 后续操作，始终以 0 退出
exit 0
{{ end -}}
