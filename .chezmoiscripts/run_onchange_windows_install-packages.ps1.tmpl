{{ if eq .chezmoi.os "windows" -}}
#!/usr/bin/env pwsh
# Windows 包安装脚本
# chezmoi apply 时自动执行
# version: 3.0.0
#
# 修改记录:
#   3.0.0 - 工具清单数据化、报告简化（去 ASCII 框）、zoxide+PSFzf、PATH 一次性写入、SHA 校验提示
#   2.2.1 - 修复 scoop update 失败后仍触发自动更新、Git 路径遍历查找
#   2.1.0 - 添加安装结果跟踪和汇总报告
#   2.0.0 - 修复 Scoop 路径硬编码、工具列表补全、容错机制、字体包名

$ErrorActionPreference = 'Stop'

# ============================================================
# 安装结果跟踪
# ============================================================
$script:Results = @{
    Success = [System.Collections.ArrayList]::new()
    Failed  = [System.Collections.ArrayList]::new()
    Skipped = [System.Collections.ArrayList]::new()
}

function Add-Result {
    param([string]$Name, [string]$Status, [string]$Detail = "", [string]$ScoopName = "")
    switch ($Status) {
        'success' { [void]$script:Results.Success.Add(@{ Name = $Name; Detail = $Detail; ScoopName = $ScoopName }) }
        'failed'  { [void]$script:Results.Failed.Add(@{ Name = $Name; Detail = $Detail; ScoopName = $ScoopName }) }
        'skipped' { [void]$script:Results.Skipped.Add(@{ Name = $Name; Detail = $Detail; ScoopName = $ScoopName }) }
    }
}

Write-Host "`n========================================" -ForegroundColor Cyan
Write-Host "  Windows 终端工具安装脚本 v3.0.0" -ForegroundColor Cyan
Write-Host "========================================`n" -ForegroundColor Cyan

# ============================================================
# 辅助函数
# ============================================================
function Install-ScoopPackage {
    param([string]$Name, [string]$DisplayName = $Name, [string]$CommandName = $Name)
    if (Get-Command $CommandName -ErrorAction SilentlyContinue) {
        Write-Host "  [OK] $DisplayName 已安装" -ForegroundColor Green
        Add-Result -Name $DisplayName -Status 'skipped' -Detail '已安装' -ScoopName $Name
        return
    }
    Write-Host "  安装 $DisplayName ..." -ForegroundColor Gray
    try {
        $output = scoop install $Name 2>&1
        $exitCode = $LASTEXITCODE
        $output | Out-Host

        if (Get-Command $CommandName -ErrorAction SilentlyContinue) {
            Write-Host "  [OK] $DisplayName 安装完成" -ForegroundColor Green
            Add-Result -Name $DisplayName -Status 'success' -ScoopName $Name
        }
        elseif ($exitCode -eq 0) {
            Write-Host "  [OK] $DisplayName 安装完成（需重启终端生效）" -ForegroundColor Green
            Add-Result -Name $DisplayName -Status 'success' -Detail '需重启终端' -ScoopName $Name
        }
        else {
            Write-Host "  [WARN] $DisplayName 安装可能未成功 (exit: $exitCode)" -ForegroundColor Yellow
            $errorMsg = ($output | Where-Object { $_ -match '(?i)error' } | Select-Object -First 1) -as [string]
            Add-Result -Name $DisplayName -Status 'failed' -Detail ($errorMsg ?? "exit code: $exitCode") -ScoopName $Name
        }
    }
    catch {
        Write-Host "  [FAIL] $DisplayName 安装失败: $_" -ForegroundColor Red
        Add-Result -Name $DisplayName -Status 'failed' -Detail "$_" -ScoopName $Name
    }
}

# ============================================================
# 1. 检测/安装 Scoop（动态路径）
# ============================================================
# 安全提示：Scoop 官方安装脚本，未做 SHA 校验
# 如需严格校验，先用 Invoke-WebRequest 下载并人工 Get-FileHash 核对
Write-Host "[1/9] 检查 Scoop ..." -ForegroundColor Cyan

$ScoopDir = $env:SCOOP
if (-not $ScoopDir) {
    $scoopCmd = Get-Command scoop -ErrorAction SilentlyContinue
    if ($scoopCmd) {
        $cfgRoot = & scoop config root_path 2>$null
        if ($cfgRoot -and (Test-Path $cfgRoot)) {
            $ScoopDir = $cfgRoot
        } else {
            $ScoopDir = Split-Path (Split-Path (Split-Path (Split-Path $scoopCmd.Source)))
        }
    }
}
if (-not $ScoopDir) { $ScoopDir = "$env:USERPROFILE\scoop" }

if (-not (Get-Command scoop -ErrorAction SilentlyContinue) -and -not (Test-Path $ScoopDir)) {
    Write-Host "  Scoop 未安装，正在安装..." -ForegroundColor Yellow
    try {
        Set-ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
        Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression
        Add-Result -Name 'Scoop' -Status 'success'
    }
    catch {
        Write-Host "  [FAIL] Scoop 安装失败: $_" -ForegroundColor Red
        Add-Result -Name 'Scoop' -Status 'failed' -Detail "$_"
        Write-Host "`n无法继续安装，Scoop 是所有工具的前置依赖。" -ForegroundColor Red
        exit 1
    }
}
else {
    Write-Host "  [OK] Scoop 已安装 ($ScoopDir)" -ForegroundColor Green
    Add-Result -Name 'Scoop' -Status 'skipped' -Detail '已安装'
}

$env:PATH = "$ScoopDir\shims;$env:PATH"

# ============================================================
# 2. Git（Scoop bucket 前置依赖）
# ============================================================
Write-Host "`n[2/9] 检查 Git（Scoop 前置依赖）..." -ForegroundColor Cyan

if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
    Write-Host "  Git 未安装，正在通过 Scoop 安装..." -ForegroundColor Yellow
    try {
        scoop install git
        if (-not (Get-Command git -ErrorAction SilentlyContinue)) { throw "安装后 git 命令仍不可用" }
        Add-Result -Name 'Git' -Status 'success'
    }
    catch {
        Write-Host "  [FAIL] Git 安装失败: $_" -ForegroundColor Red
        Add-Result -Name 'Git' -Status 'failed' -Detail "$_"
        exit 1
    }
}
else {
    Write-Host "  [OK] Git 已安装" -ForegroundColor Green
    Add-Result -Name 'Git' -Status 'skipped' -Detail '已安装'
}

# 修复 Git safe.directory（Git 2.35.2+ 拒绝 dubious ownership 的目录）
if (Get-Command git -ErrorAction SilentlyContinue) {
    $scoopDirs = @(
        "$ScoopDir/apps/scoop/current"
        "$ScoopDir/buckets/main"
        "$ScoopDir/buckets/extras"
        "$ScoopDir/buckets/nerd-fonts"
    )
    foreach ($d in $scoopDirs) {
        $dNorm = $d -replace '\\', '/'
        $existing = git config --global --get-all safe.directory 2>$null
        if ($existing -notcontains $dNorm) {
            git config --global --add safe.directory $dNorm 2>$null
        }
    }
}

# ============================================================
# 3. Scoop buckets
# ============================================================
Write-Host "`n[3/9] 配置 Scoop buckets ..." -ForegroundColor Cyan

$buckets = scoop bucket list 2>$null | Select-Object -ExpandProperty Name -ErrorAction SilentlyContinue
foreach ($bucket in @('extras', 'nerd-fonts')) {
    if ($buckets -notcontains $bucket) {
        Write-Host "  添加 $bucket bucket ..." -ForegroundColor Gray
        try {
            scoop bucket add $bucket
            Add-Result -Name "Bucket: $bucket" -Status 'success'
        }
        catch {
            Add-Result -Name "Bucket: $bucket" -Status 'failed' -Detail "$_"
        }
    }
    else {
        Write-Host "  [OK] $bucket bucket 已存在" -ForegroundColor Green
        Add-Result -Name "Bucket: $bucket" -Status 'skipped' -Detail '已存在'
    }
}

# ============================================================
# 4. PowerShell 7
# ============================================================
Write-Host "`n[4/9] 检查 PowerShell 7 ..." -ForegroundColor Cyan

if (-not (Get-Command pwsh -ErrorAction SilentlyContinue)) {
    Write-Host "  安装 PowerShell 7 ..." -ForegroundColor Yellow
    try {
        scoop install pwsh
        Add-Result -Name 'PowerShell 7' -Status 'success' -Detail (
            (Get-Command pwsh -ErrorAction SilentlyContinue) ? '' : '需重启终端')
    }
    catch {
        Add-Result -Name 'PowerShell 7' -Status 'failed' -Detail "$_"
    }
}
else {
    Write-Host "  [OK] PowerShell 7 已安装" -ForegroundColor Green
    Add-Result -Name 'PowerShell 7' -Status 'skipped' -Detail '已安装'
}

# 设为 Windows Terminal 默认
$wtSettingsPath = "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json"
if (Test-Path $wtSettingsPath) {
    Write-Host "  配置 Windows Terminal 默认 shell ..." -ForegroundColor Gray
    try {
        $wtSettings = Get-Content $wtSettingsPath -Raw | ConvertFrom-Json
        $pwshProfile = $wtSettings.profiles.list | Where-Object {
            $_.name -like "*PowerShell*" -and $_.source -eq "Windows.Terminal.PowershellCore"
        }
        if ($pwshProfile) {
            $wtSettings.defaultProfile = $pwshProfile.guid
            $newJson = $wtSettings | ConvertTo-Json -Depth 100
            # 用 .NET API 写 UTF-8 无 BOM
            [System.IO.File]::WriteAllText($wtSettingsPath, $newJson, [System.Text.UTF8Encoding]::new($false))
            Write-Host "  [OK] PowerShell 7 已设为默认 shell" -ForegroundColor Green
        }
    }
    catch {
        Write-Host "  [WARN] 配置 Windows Terminal 失败: $_" -ForegroundColor Yellow
    }
}

# ============================================================
# 5. 终端工具（容错：单个失败不影响后续）
# ============================================================
Write-Host "`n[5/9] 安装终端工具 ..." -ForegroundColor Cyan

$ErrorActionPreference = 'Continue'

# 先统一更新 Scoop 索引
Write-Host "  更新 Scoop 索引 ..." -ForegroundColor Gray
scoop update 2>&1 | Out-Null
if ($LASTEXITCODE -ne 0) {
    Write-Host "  [WARN] Scoop 更新失败，跳过后续自动更新 ..." -ForegroundColor Yellow
    scoop config last_update ([System.DateTime]::Now.ToString('o')) 2>$null
} else {
    Write-Host "  [OK] Scoop 索引已更新" -ForegroundColor Green
}

# 工具清单（从 .chezmoidata/tools.yaml 自动生成）
{{- range .toolList }}
{{-   if .scoop }}
{{-     $cmd := .cmd | default .scoop }}
Install-ScoopPackage -Name "{{ .scoop }}" -DisplayName "{{ .name }}" -CommandName "{{ $cmd }}"
{{-   end }}
{{- end }}

$ErrorActionPreference = 'Stop'

# ============================================================
# 6. PSFzf 模块（PowerShell fzf 集成）
# ============================================================
Write-Host "`n[6/9] 安装 PSFzf 模块 ..." -ForegroundColor Cyan

if (-not (Get-Module -ListAvailable PSFzf)) {
    try {
        Install-Module -Name PSFzf -Scope CurrentUser -Force -AllowClobber -SkipPublisherCheck 2>&1 | Out-Host
        Write-Host "  [OK] PSFzf 安装完成" -ForegroundColor Green
        Add-Result -Name 'PSFzf' -Status 'success'
    }
    catch {
        Write-Host "  [WARN] PSFzf 安装失败: $_" -ForegroundColor Yellow
        Add-Result -Name 'PSFzf' -Status 'failed' -Detail "$_"
    }
}
else {
    Write-Host "  [OK] PSFzf 已安装" -ForegroundColor Green
    Add-Result -Name 'PSFzf' -Status 'skipped' -Detail '已安装'
}

# 升级 PSReadLine 到 2.3+ (PS 7 默认 2.0，2.3+ 才有完整 ListView 预测)
$psrlMin = [Version]'2.3.0'
$psrlInstalled = (Get-Module -ListAvailable PSReadLine | Sort-Object Version -Descending | Select-Object -First 1).Version
if (-not $psrlInstalled -or $psrlInstalled -lt $psrlMin) {
    Write-Host "  升级 PSReadLine 到 2.3+ ..." -ForegroundColor Gray
    try {
        Install-Module -Name PSReadLine -MinimumVersion 2.3 -Scope CurrentUser -Force -AllowClobber -SkipPublisherCheck 2>&1 | Out-Host
        Write-Host "  [OK] PSReadLine 已升级（重启 PowerShell 生效）" -ForegroundColor Green
        Add-Result -Name 'PSReadLine 2.3+' -Status 'success' -Detail '需重启终端'
    }
    catch {
        Write-Host "  [WARN] PSReadLine 升级失败: $_" -ForegroundColor Yellow
        Add-Result -Name 'PSReadLine 2.3+' -Status 'failed' -Detail "$_"
    }
}
else {
    Write-Host "  [OK] PSReadLine $psrlInstalled 已满足 (≥ 2.3)" -ForegroundColor Green
    Add-Result -Name 'PSReadLine 2.3+' -Status 'skipped' -Detail "v$psrlInstalled"
}

# ============================================================
# 7. YAZI_FILE_ONE 环境变量
# ============================================================
Write-Host "`n[7/9] 配置 YAZI_FILE_ONE 环境变量 ..." -ForegroundColor Cyan

$fileExePath = $null
$gitExecPath = & git --exec-path 2>$null
if ($gitExecPath) {
    $dir = $gitExecPath
    for ($i = 0; $i -lt 5; $i++) {
        $dir = Split-Path $dir
        if (-not $dir) { break }
        $candidate = Join-Path $dir "usr\bin\file.exe"
        if (Test-Path $candidate) { $fileExePath = $candidate; break }
    }
}

if ($fileExePath) {
    [System.Environment]::SetEnvironmentVariable("YAZI_FILE_ONE", $fileExePath, "User")
    $env:YAZI_FILE_ONE = $fileExePath
    Write-Host "  [OK] YAZI_FILE_ONE = $fileExePath" -ForegroundColor Green
    Add-Result -Name 'YAZI_FILE_ONE' -Status 'success'
}
else {
    Write-Host "  [WARN] file.exe 未找到，yazi 文件类型检测可能不准确" -ForegroundColor Yellow
    Add-Result -Name 'YAZI_FILE_ONE' -Status 'failed' -Detail "file.exe 未找到"
}

# ============================================================
# 8. 用户 PATH 一次性注入（profile 不再每次循环）
# ============================================================
Write-Host "`n[8/9] 注入用户 PATH ..." -ForegroundColor Cyan

$ExtraPaths = @(
    "$env:USERPROFILE\bin",
    "$env:USERPROFILE\.local\bin"
)

$userPath = [System.Environment]::GetEnvironmentVariable('PATH', 'User')
$userPathSet = ($userPath -split ';') | Where-Object { $_ } | ForEach-Object { $_.TrimEnd('\') }
$pathChanged = $false

foreach ($p in $ExtraPaths) {
    if ((Test-Path $p) -and ($userPathSet -notcontains $p.TrimEnd('\'))) {
        $userPath = "$p;$userPath"
        $pathChanged = $true
        Write-Host "  添加到用户 PATH: $p" -ForegroundColor Gray
    }
}

if ($pathChanged) {
    [System.Environment]::SetEnvironmentVariable('PATH', $userPath, 'User')
    Write-Host "  [OK] 用户 PATH 已更新（新终端会话生效）" -ForegroundColor Green
    Add-Result -Name 'User PATH' -Status 'success'
}
else {
    Write-Host "  [OK] 用户 PATH 已包含目标路径" -ForegroundColor Green
    Add-Result -Name 'User PATH' -Status 'skipped'
}

# ============================================================
# 9. PowerShell Profile 同步（处理 Documents 重定向）
# ============================================================
Write-Host "`n[9/9] 同步 PowerShell Profile ..." -ForegroundColor Cyan

$chezmoiProfile = Join-Path $env:USERPROFILE "Documents\PowerShell\Microsoft.PowerShell_profile.ps1"
$actualProfile = & pwsh -NoLogo -NonInteractive -Command 'echo $PROFILE' 2>$null
if (-not $actualProfile) {
    $actualProfile = & powershell -NoLogo -NonInteractive -Command 'echo $PROFILE' 2>$null
}

if ($actualProfile -and $chezmoiProfile -and ($actualProfile -ne $chezmoiProfile) -and (Test-Path $chezmoiProfile)) {
    Write-Host "  chezmoi 部署位置: $chezmoiProfile" -ForegroundColor Gray
    Write-Host "  PowerShell 期望:  $actualProfile" -ForegroundColor Gray
    New-Item -ItemType Directory -Force -Path (Split-Path $actualProfile) | Out-Null
    Copy-Item $chezmoiProfile $actualProfile -Force
    Write-Host "  [OK] Profile 已同步" -ForegroundColor Green
    Add-Result -Name 'PowerShell Profile' -Status 'success' -Detail '已同步'
}
elseif ($actualProfile -and (Test-Path $actualProfile)) {
    Write-Host "  [OK] Profile 已存在" -ForegroundColor Green
    Add-Result -Name 'PowerShell Profile' -Status 'skipped' -Detail '路径一致'
}
else {
    Write-Host "  [WARN] 无法确定 Profile 路径，请手动复制" -ForegroundColor Yellow
    Add-Result -Name 'PowerShell Profile' -Status 'failed' -Detail '路径检测失败'
}

# ============================================================
# Nerd Font
# ============================================================
Write-Host "`n[+] 检查 Nerd Font ..." -ForegroundColor Cyan

$fontInstalled = $false
$sysFonts = Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts' -ErrorAction SilentlyContinue
if ($sysFonts) {
    foreach ($font in $sysFonts.PSObject.Properties) {
        if ($font.Name -like "*Meslo*Nerd*") { $fontInstalled = $true; break }
    }
}
if (-not $fontInstalled -and (Test-Path "$env:LOCALAPPDATA\Microsoft\Windows\Fonts\*Meslo*Nerd*")) { $fontInstalled = $true }
if (-not $fontInstalled -and (Test-Path "$ScoopDir\apps\Meslo-NF")) { $fontInstalled = $true }

if ($fontInstalled) {
    Write-Host "  [OK] Meslo Nerd Font 已安装" -ForegroundColor Green
    Add-Result -Name 'Meslo Nerd Font' -Status 'skipped' -Detail '已安装'
}
else {
    try {
        $output = scoop install Meslo-NF 2>&1
        $output | Out-Host
        if (Test-Path "$ScoopDir\apps\Meslo-NF") {
            Write-Host "  [OK] Meslo Nerd Font 安装完成" -ForegroundColor Green
            Add-Result -Name 'Meslo Nerd Font' -Status 'success'
        }
        else {
            Add-Result -Name 'Meslo Nerd Font' -Status 'failed' -Detail '安装后未检测到字体文件'
        }
    }
    catch {
        Add-Result -Name 'Meslo Nerd Font' -Status 'failed' -Detail "$_"
    }
}

# ============================================================
# 安装报告（竖向列表，避免 ASCII 表中文宽度对不齐）
# ============================================================
Write-Host ""
Write-Host "─────────── 安 装 报 告 ───────────" -ForegroundColor Cyan

if ($script:Results.Skipped.Count -gt 0) {
    Write-Host "✅ 已安装 ($($script:Results.Skipped.Count))" -ForegroundColor Green
    foreach ($item in $script:Results.Skipped) {
        Write-Host "    • $($item.Name)" -ForegroundColor Gray
    }
}
if ($script:Results.Success.Count -gt 0) {
    Write-Host "🆕 新安装 ($($script:Results.Success.Count))" -ForegroundColor Green
    foreach ($item in $script:Results.Success) {
        $detail = if ($item.Detail) { " ($($item.Detail))" } else { "" }
        Write-Host "    • $($item.Name)$detail" -ForegroundColor White
    }
}
if ($script:Results.Failed.Count -gt 0) {
    Write-Host "❌ 失败 ($($script:Results.Failed.Count))" -ForegroundColor Red
    foreach ($item in $script:Results.Failed) {
        Write-Host "    • $($item.Name)" -ForegroundColor Red
        if ($item.Detail) {
            Write-Host "        → $($item.Detail)" -ForegroundColor DarkGray
        }
    }
}

Write-Host "─────────────────────────────────────" -ForegroundColor Cyan

$total = $script:Results.Success.Count + $script:Results.Failed.Count + $script:Results.Skipped.Count
if ($script:Results.Failed.Count -eq 0) {
    Write-Host "✓ 全部完成！共 $total 项，无失败" -ForegroundColor Green
}
else {
    Write-Host "⚠ 共 $total 项: $($script:Results.Success.Count) 新装 · $($script:Results.Failed.Count) 失败 · $($script:Results.Skipped.Count) 已有" -ForegroundColor Yellow
}

# 失败项重试指南
if ($script:Results.Failed.Count -gt 0) {
    Write-Host ""
    Write-Host "💡 修复建议:" -ForegroundColor Yellow
    foreach ($item in $script:Results.Failed) {
        if ($item.ScoopName) {
            Write-Host "   scoop install $($item.ScoopName)" -ForegroundColor White
        }
    }
    Write-Host "   或重新运行: chezmoi apply" -ForegroundColor Gray
}

# 后续步骤
Write-Host ""
Write-Host "📝 后续步骤:" -ForegroundColor Cyan
Write-Host "  1. 重启 PowerShell / Windows Terminal"
Write-Host "  2. 在 Windows Terminal 设置中将字体设为 'MesloLGS Nerd Font'"
Write-Host "  3. 享受你的新终端环境！"
Write-Host ""

exit 0
{{ end -}}
