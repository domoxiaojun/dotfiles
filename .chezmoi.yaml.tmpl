{{- if not (lookPath "git") -}}
{{-   fail `
========================================
  ❌ 未检测到 Git，请先安装 Git！

  📦 安装方法：

  🐧 Debian/Ubuntu:
     sudo apt update && sudo apt install -y git

  🐧 CentOS/RHEL/Fedora:
     sudo dnf install -y git

  🍎 macOS:
     brew install git

  🪟 Windows:
     winget install Git.Git

  安装完成后请重新运行:
     chezmoi init --apply domoxiaojun
========================================
` -}}
{{- end -}}
{{- $email := get . "email" | default (output "git" "config" "user.email" | trim) -}}
{{- $name := get . "name" | default (output "git" "config" "user.name" | trim) -}}
sourceDir: {{ .chezmoi.sourceDir | quote }}

data:
  name: {{ $name | quote }}
  email: {{ $email | quote }}

  # 终端配置
  terminal:
    ghostty:
      theme: "catppuccin-mocha"
      font: "MesloLGS Nerd Font Mono"
      font_size: 13.5

  # Git 配置
  git:
    user:
      name: {{ $name | quote }}
      email: {{ $email | quote }}
    delta:
      enabled: {{ if lookPath "delta" }}true{{ else }}false{{ end }}
      side_by_side: true

  # Shell 配置
  shell:
    starship:
      enabled: {{ if lookPath "starship" }}true{{ else }}false{{ end }}
    zsh_plugins:
      - "zsh-syntax-highlighting"
      - "zsh-autosuggestions"

  # 工具配置
  tools:
    lsd: {{ if lookPath "lsd" }}true{{ else }}false{{ end }}
    bat: {{ if lookPath "bat" }}true{{ else }}false{{ end }}
    delta: {{ if lookPath "delta" }}true{{ else }}false{{ end }}
    btop: {{ if lookPath "btop" }}true{{ else }}false{{ end }}
    glow: {{ if lookPath "glow" }}true{{ else }}false{{ end }}
    fx: {{ if lookPath "fx" }}true{{ else }}false{{ end }}
    fzf: {{ if lookPath "fzf" }}true{{ else }}false{{ end }}
