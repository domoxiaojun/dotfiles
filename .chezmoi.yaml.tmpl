{{- /* 初始化时跳过已有数据 */ -}}
{{- $existingName := "" -}}
{{- $existingEmail := "" -}}
{{- if hasKey . "name" -}}
{{-   $existingName = .name -}}
{{- end -}}
{{- if hasKey . "email" -}}
{{-   $existingEmail = .email -}}
{{- end -}}

{{- /* 获取现有 git 配置 */ -}}
{{- $gitName := "" -}}
{{- $gitEmail := "" -}}
{{- if lookPath "git" -}}
{{-   $gitEmail = output "git" "config" "--default" "" "user.email" | trim -}}
{{-   $gitName = output "git" "config" "--default" "" "user.name" | trim -}}
{{- end -}}

{{- /* 如果已有配置则跳过交互 */ -}}
{{- $name := $existingName -}}
{{- $email := $existingEmail -}}

{{- if not (and $existingName $existingEmail) -}}
{{- /* 交互式选择 git 用户配置来源 */ -}}
{{-   $gitConfigChoice := "" -}}
{{-   if stdinIsATTY -}}
{{-     $choices := list "default (使用默认值)" -}}
{{-     if and $gitName $gitEmail -}}
{{-       $choices = append $choices (printf "git (从 git config 读取: %s <%s>)" $gitName $gitEmail) -}}
{{-     end -}}
{{-     $choices = append $choices "custom (手动输入)" -}}
{{-     $gitConfigChoice = promptChoice "Git 用户配置来源" $choices -}}
{{-   else -}}
{{-     $gitConfigChoice = "default (使用默认值)" -}}
{{-   end -}}

{{- /* 根据选择设置 name 和 email */ -}}
{{-   if hasPrefix "git" $gitConfigChoice -}}
{{-     $name = $gitName -}}
{{-     $email = $gitEmail -}}
{{-   else if hasPrefix "custom" $gitConfigChoice -}}
{{-     $name = promptString "请输入用户名" -}}
{{-     $email = promptString "请输入邮箱" -}}
{{-   else -}}
{{-     $name = default (env "USER") (env "USERNAME") | default "Your Name" -}}
{{-     $email = "your-email@example.com" -}}
{{-   end -}}
{{- end -}}

sourceDir: {{ .chezmoi.sourceDir | quote }}

{{ if eq .chezmoi.os "windows" -}}
interpreters:
  ps1:
    command: pwsh
    args: ["-NoLogo", "-NonInteractive"]
{{ end -}}

data:
  name: {{ $name | quote }}
  email: {{ $email | quote }}

  # 终端配置
  terminal:
    ghostty:
      theme: "catppuccin-mocha"
      font: "MesloLGS Nerd Font Mono"
      font_size: 13.5

  # Git 配置
  git:
    user:
      name: {{ $name | quote }}
      email: {{ $email | quote }}
    delta:
      enabled: {{ if lookPath "delta" }}true{{ else }}false{{ end }}
      side_by_side: true

  # Shell 配置
  shell:
    starship:
      enabled: {{ if lookPath "starship" }}true{{ else }}false{{ end }}
    zsh_plugins:
      - "zsh-syntax-highlighting"
      - "zsh-autosuggestions"

  # 工具配置
  tools:
    lsd: {{ if lookPath "lsd" }}true{{ else }}false{{ end }}
    bat: {{ if lookPath "bat" }}true{{ else }}false{{ end }}
    delta: {{ if lookPath "delta" }}true{{ else }}false{{ end }}
    btop: {{ if lookPath "btop" }}true{{ else }}false{{ end }}
    glow: {{ if lookPath "glow" }}true{{ else }}false{{ end }}
    fx: {{ if lookPath "fx" }}true{{ else }}false{{ end }}
    fzf: {{ if lookPath "fzf" }}true{{ else }}false{{ end }}
    yazi: {{ if lookPath "yazi" }}true{{ else }}false{{ end }}
    fd: {{ if or (lookPath "fd") (lookPath "fdfind") }}true{{ else }}false{{ end }}
    rg: {{ if lookPath "rg" }}true{{ else }}false{{ end }}

  # 系统信息 (用于跨平台模板)
  system:
    os: {{ .chezmoi.os | quote }}
{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi "osRelease") }}
    distro: {{ .chezmoi.osRelease.id | default "unknown" | quote }}
    distro_version: {{ .chezmoi.osRelease.versionID | default "" | quote }}
    is_fedora: {{ if eq (.chezmoi.osRelease.id | default "") "fedora" }}true{{ else }}false{{ end }}
    is_ubuntu: {{ if eq (.chezmoi.osRelease.id | default "") "ubuntu" }}true{{ else }}false{{ end }}
    is_debian: {{ if eq (.chezmoi.osRelease.id | default "") "debian" }}true{{ else }}false{{ end }}
    is_wayland: {{ if env "WAYLAND_DISPLAY" }}true{{ else }}false{{ end }}
{{- else }}
    distro: ""
    distro_version: ""
    is_fedora: false
    is_ubuntu: false
    is_debian: false
    is_wayland: false
{{- end }}
