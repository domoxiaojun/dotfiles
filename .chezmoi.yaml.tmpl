{{- $name := "" -}}
{{- $email := "" -}}
{{- $dataName := get . "name" -}}
{{- $dataEmail := get . "email" -}}
{{- if lookPath "git" -}}
{{-   $email = output "git" "config" "--default" "" "user.email" | trim -}}
{{-   $name = output "git" "config" "--default" "" "user.name" | trim -}}
{{- end -}}
{{- $name = default $dataName $name | default (env "USER") | default (env "USERNAME") | default "Your Name" -}}
{{- $email = default $dataEmail $email | default "your-email@example.com" -}}
sourceDir: {{ .chezmoi.sourceDir | quote }}

{{ if eq .chezmoi.os "windows" -}}
interpreters:
  ps1:
    command: pwsh
    args: ["-NoLogo", "-NonInteractive"]
{{ end -}}

data:
  name: {{ $name | quote }}
  email: {{ $email | quote }}

  # 终端配置
  terminal:
    ghostty:
      theme: "catppuccin-mocha"
      font: "MesloLGS Nerd Font Mono"
      font_size: 13.5

  # Git 配置
  git:
    user:
      name: {{ $name | quote }}
      email: {{ $email | quote }}
    delta:
      enabled: {{ if lookPath "delta" }}true{{ else }}false{{ end }}
      side_by_side: true

  # Shell 配置
  shell:
    starship:
      enabled: {{ if lookPath "starship" }}true{{ else }}false{{ end }}
    zsh_plugins:
      - "zsh-syntax-highlighting"
      - "zsh-autosuggestions"

  # 工具配置
  tools:
    lsd: {{ if lookPath "lsd" }}true{{ else }}false{{ end }}
    bat: {{ if lookPath "bat" }}true{{ else }}false{{ end }}
    delta: {{ if lookPath "delta" }}true{{ else }}false{{ end }}
    btop: {{ if lookPath "btop" }}true{{ else }}false{{ end }}
    glow: {{ if lookPath "glow" }}true{{ else }}false{{ end }}
    fx: {{ if lookPath "fx" }}true{{ else }}false{{ end }}
    fzf: {{ if lookPath "fzf" }}true{{ else }}false{{ end }}
    yazi: {{ if lookPath "yazi" }}true{{ else }}false{{ end }}
