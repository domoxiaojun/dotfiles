{{- /* ======================================================
   Git 用户信息：
   - 若本机 git config 有有效值（非占位符），弹菜单让用户选「使用当前 / 手动输入」
   - 否则直接逐项询问
   - 所有 prompt 都用 *Once 版，答案缓存到 chezmoi state，下次 init 不再问
   - 要重新选择：chezmoi state delete-bucket --bucket=entryState
   ====================================================== */ -}}

{{- /* 第一步：探测本机 git config */ -}}
{{- $gitName := "" -}}
{{- $gitEmail := "" -}}
{{- if lookPath "git" -}}
{{-   $n := output "git" "config" "--default" "" "user.name"  | trim -}}
{{-   $e := output "git" "config" "--default" "" "user.email" | trim -}}
{{-   if and $n (ne $n "Your Name") }}{{ $gitName = $n }}{{ end -}}
{{-   if and $e (ne $e "your-email@example.com") }}{{ $gitEmail = $e }}{{ end -}}
{{- end -}}

{{- /* 第二步：根据探测结果决定走「菜单」还是「直接询问」 */ -}}
{{- $name  := "" -}}
{{- $email := "" -}}

{{- if and $gitName $gitEmail -}}
{{/* 有有效 git config：弹二选一菜单 */}}
{{-   $msg := printf "检测到当前 git 配置: %s <%s>。选择来源 (git=使用当前 / custom=手动输入)" $gitName $gitEmail -}}
{{-   $choice := promptChoiceOnce . "git_source" $msg (list "git" "custom") "git" -}}
{{-   if eq $choice "git" -}}
{{-     $name  = $gitName -}}
{{-     $email = $gitEmail -}}
{{-   else -}}
{{-     $name  = promptStringOnce . "name"  "Git 用户名" $gitName -}}
{{-     $email = promptStringOnce . "email" "Git 邮箱"   $gitEmail -}}
{{-   end -}}
{{- else -}}
{{/* 没有 git config 或值是占位符：直接逐项询问 */}}
{{-   $defaultName := default (env "USER") (env "USERNAME") | default "Your Name" -}}
{{-   $name  = promptStringOnce . "name"  "Git 用户名" $defaultName -}}
{{-   $email = promptStringOnce . "email" "Git 邮箱"   "your-email@example.com" -}}
{{- end -}}

sourceDir: {{ .chezmoi.sourceDir | quote }}

{{ if eq .chezmoi.os "windows" -}}
interpreters:
  ps1:
    command: {{ if lookPath "pwsh" }}pwsh{{ else }}powershell{{ end }}
    args: ["-NoLogo", "-NonInteractive"]
{{ end -}}

data:
  name: {{ $name | quote }}
  email: {{ $email | quote }}

  # Git 配置
  git:
    user:
      name: {{ $name | quote }}
      email: {{ $email | quote }}
    delta:
      enabled: {{ if lookPath "delta" }}true{{ else }}false{{ end }}
      side_by_side: true

  # Shell 配置
  shell:
    starship:
      enabled: {{ if lookPath "starship" }}true{{ else }}false{{ end }}

  # 工具配置（遍历 .chezmoidata/tools.yaml 自动检测，添加新工具时改 yaml 即可）
  # 注意：.chezmoi.yaml.tmpl 在 init 阶段渲染，此时 .chezmoidata 尚未加载，
  # 所以这里用 include + fromYaml 直接读取（chezmoi 文档推荐做法）。
  tools:
{{- $tools := include ".chezmoidata/tools.yaml" | fromYaml }}
{{- range $tools.toolList }}
{{-   if .cmd }}
{{-     $altCmd := index . "apt_cmd" | default "" }}
    {{ .cmd }}: {{ if or (lookPath .cmd) (and (ne $altCmd "") (lookPath $altCmd)) }}true{{ else }}false{{ end }}
{{-   end }}
{{- end }}

  # 系统信息 (用于跨平台模板)
  system:
    os: {{ .chezmoi.os | quote }}
{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi "osRelease") }}
    distro: {{ .chezmoi.osRelease.id | default "unknown" | quote }}
    distro_version: {{ .chezmoi.osRelease.versionID | default "" | quote }}
    is_fedora: {{ if eq (.chezmoi.osRelease.id | default "") "fedora" }}true{{ else }}false{{ end }}
    is_ubuntu: {{ if eq (.chezmoi.osRelease.id | default "") "ubuntu" }}true{{ else }}false{{ end }}
    is_debian: {{ if eq (.chezmoi.osRelease.id | default "") "debian" }}true{{ else }}false{{ end }}
    is_wayland: {{ if env "WAYLAND_DISPLAY" }}true{{ else }}false{{ end }}
{{- else }}
    distro: ""
    distro_version: ""
    is_fedora: false
    is_ubuntu: false
    is_debian: false
    is_wayland: false
{{- end }}
