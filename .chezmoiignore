# ============================================================
# chezmoi 忽略规则
# 根据不同平台选择性应用配置
# ============================================================

# 项目元数据/文档（仅在仓库内有意义，不部署到 home 目录）
README.md
LICENSE
CHANGELOG.md
CLAUDE.md
todos.md
.claude/
.editorconfig
.gitattributes
.github/

# Windows 上忽略 Unix 专属配置
{{ if eq .chezmoi.os "windows" }}
.tmux.conf
.zshrc
.bash_aliases
.zprofile
.vimrc
.config/ghostty/
{{ end }}

# Documents 目录仅 Windows 需要 (PowerShell profile)
{{ if ne .chezmoi.os "windows" }}
Documents/
{{ end }}

# .bashrc.d 仅 Linux 需要（Fedora/RHEL 系默认 bashrc 只加载 ~/.bashrc.d/*）
{{ if ne .chezmoi.os "linux" }}
.bashrc.d/
{{ end }}

# Linux 上忽略 .zshrc (使用系统默认 shell + .bash_aliases)
# 注意: 如果你想在 Linux 上也用 zsh，注释掉下面这行
{{ if eq .chezmoi.os "linux" }}
.zshrc
.zprofile
{{ end }}

# 备份文件
*.backup.*

# 临时文件
.DS_Store
*.swp
*.swo
*~

# 私密文件不同步到 GitHub（如需同步部分 SSH 配置，建议用 chezmoi encrypt 加密）
.ssh/
.gnupg/

# 辅助脚本目录（不同步到 home）
scripts/
